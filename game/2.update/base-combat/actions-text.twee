		<<if $speech_attitude is "meek">>
			<<switch $_rng>>
				<<case 1>> "오, 오지 마." 당신이 말한다. "나, 난 스스로를 지킬 수 있어."
				<<case 2>> "제발 더 가까이 오지 마세요." 당신이 말한다.
				<<case 3>> "절 상처 입히지 마세요." 당신이 말한다. "제발요."
				<<case 4>> "날 건드리면 곤란해질 거야." 당신이 말한다.
				<<case 5>> "아무 짓도 하지 마." 당신이 말한다. "여, 여기 있는 거 사람들이 알아."
			<</switch>>
		<<elseif $speech_attitude is "bratty">>
			<<switch $_rng>>
				<<case 1>> "썩 꺼져." 당신이 말한다. "안 그러면 후회하게 만들어 줄 테니."
				<<case 2>> "날 건드리면 네 엉덩이를 걷어차 주겠어." 당신이 말한다.
				<<case 3>> "뭘 봐?" 당신이 묻는다.
				<<case 4>> "계속 가던 길 가." 당신이 말한다. "안 그러면 네 얼굴을 부숴버릴 테니."
				<<case 5>> "생각도 하지 마." 당신이 말한다. "너보다 더한 쓰레기들도 상대해 봤으니까."
			<</switch>>
		<<else>>
			<<switch $_rng>>
				<<case 1>> "거리를 유지해." 당신이 말한다. "안 그러면 후회하게 될 거야."
				<<case 2>> "날 건드리지 마." 당신이 말한다. "안 그러면 곤란해질 거야."
				<<case 3>> "아무 짓도 하지 마." 당신이 말한다.
				<<case 4>> "내 몸은 내가 지킬 줄 알아." 당신이 말한다. "감히 어딜."
				<<case 5>> "계속 움직여." 당신이 말한다. "난 무방비 상태가 아니야."
			<</switch>>
		<</if>>
	<</if>>
<</widget>>

<<widget "actionstaunt">>
	<<if $angel gte 6 and random(1, 2) is 2>>
		<<switch random(1, 3)>>
			<<case 1>> "천사를 쫓으면 천국을 찾게 될 거야." 당신이 말한다.
			<<case 2>> "사랑하는 죄인이여, 천사를 따라잡을 수 있다고 믿어?"
			<<case 3>> "나와 함께 낙원으로 달려가자, 죄인이여."
		<</switch>>
	<<elseif $fallenangel gte 2 and random(1, 2) is 2>>
		<<switch random(1, 3)>>
			<<case 1>> "다른 사람들처럼 날 해치고 싶다면," 당신은 웃으며 말을 꺼낸다. "그만한 노력을 해야 할걸."
			<<case 2>> "두 번 다시 더럽혀지지 않을 거야." 당신이 말한다.
			<<case 3>> "넌 날 해치지 못해," 당신이 말한다. "두 번 다신 안 돼."
		<</switch>>
	<<elseif $demon gte 6 and random(1, 2) is 2>>
		<<switch random(1, 3)>>
			<<case 1>> "나를 '사냥감'으로 삼을 셈이야?" 당신이 씩 웃으며 묻는다. "얼마나 원하는지 보여봐."
			<<case 2>> "눈을 떼지 못했지," 당신이 말한다. "이런 데엔 익숙해. 보는 건 되지만, 만질 순 없어!"
			<<case 3>> "어디 한 번 해 봐," 당신이 말한다. "재밌는 추격전만큼 식욕을 돋우는 것도 없으니까."
		<</switch>>
	<<elseif $wolfgirl gte 6 and random(1, 2) is 2>>
		<<switch random(1, 3)>>
			<<case 1>> "날 쫓아와 봐," 당신이 말한다. "어디 한 번 해 보시지." 당신은 드러난 송곳니 위로 혀를 핥는다.
			<<case 2>> 당신이 으르렁거린다.
			<<case 3>> "혼자일지는 몰라도," 당신이 말한다. "외로운 늑대가 더 빠른 법이지."
		<</switch>>
	<<elseif $cat gte 6 and random(1, 2) is 2>>
		<<switch random(1, 3)>>
			<<case 1>> "난 네가 잡기엔 너무 빠를걸," 당신이 말한다. "어디 시험해 봐." 당신은 드러난 송곳니 위로 혀를 핥는다.
			<<case 2>> 당신이 하악질한다.
			<<case 3>> "날 쫓아와 봐," 당신이 말한다. "이 발톱을 쓰고 싶어 근질거리니까."
		<</switch>>
	<<elseif $cow gte 6 and random(1, 2) is 2>>
		<<switch random(1, 3)>>
			<<case 1>> "난 만만하지 않아," 당신이 말한다. "돌진하는 소를 쓰러뜨릴 순 없을걸."
			<<case 2>> "내가 좋은 상인 건 알아," 당신이 말한다. "하지만 먼저 날 잡아야 할 텐데."
			<<case 3>> "항상 내 우유만 노리지," 당신이 쯧쯧 혀를 찬다. "하지만 넌 아직 자격이 없어."
		<</switch>>
	<<elseif $harpy gte 6 and random(1, 2) is 2>>
		<<switch random(1, 3)>>
			<<case 1>> 당신이 새된 소리를 낸다.
			<<case 2>> "이 날개는 장식이 아니라고," 당신이 말한다.
			<<case 3>> "공포의 짝을 쫓아갈 수 있을 거라 생각해?" 당신이 묻는다.
		<</switch>>
	<<elseif $fox gte 6 and random(1, 2) is 2>>
		<<switch random(1, 3)>>
			<<case 1>> "재미있어 보이네. 자, 얼마나 빠른지 보여줘 봐!"
			<<case 2>> 당신은 짖으며, 꼬리를 부풀린다. "자, 와서 날 잡아 봐!"
			<<case 3>> "난 항상 쫓기는 게 재밌더라. 네 실력을 한 번 보여봐."
		<</switch>>
	<<elseif $anxiety gte 1 and $controlled is 0>>
		<<switch random(1, 3)>>
			<<case 1>> 당신은 말을 하려 하지만, 공포가 당신의 목소리를 앗아간다.
			<<case 2>> 당신은 말문이 막힌다. 가슴 속에서 심장이 요동친다.
			<<case 3>> 공포가 당신의 머릿속을 집어삼킨다.
		<</switch>>
		<<gstress>><<stress 6>>
	<<else>>
		<<set $_rng to random(1, 5)>>
		<<if $speech_attitude is "meek">>
			<<switch $_rng>>
				<<case 1>> "물, 물러서," 당신이 수줍게 웃으며 말한다. "나, 난 도망칠 수 없단 말이야."
				<<case 2>> "제발 다가오지 마," 당신이 수줍게 웃으며 말한다. "난, 난 저항할 수 없어."
				<<case 3>> "날 해치지 마," 당신이 수줍게 웃으며 말한다. "날 잡을 수만 있다면 말이야."
				<<case 4>> "날 잡으면, 부드럽게 대해줘," 당신이 수줍게 웃으며 말한다.
				<<case 5>> "내가 여기 있다는 걸 아무도 몰라," 당신이 수줍게 웃으며 말한다. "날 잡으면, 난 저항할 수 없을 거야."
			<</switch>>
		<<elseif $speech_attitude is "bratty">>
			<<switch $_rng>>
				<<case 1>> "맛 좀 볼래? 네 실력을 한 번 보여봐."
				<<case 2>> "너 같은 놈이 날 잡을 수 있을 리가 없잖아," 당신이 말한다.
				<<case 3>> 당신은 과장되게 웃는다. "너 따윈 쉽게 따돌릴 수 있겠네."
				<<case 4>> "그래, 넌 운동 좀 해야 할 것처럼 생겼네," 당신이 싱긋 웃으며 말한다.
				<<case 5>> "이거보다 더한 놈들도 따돌려 봤어," 당신이 싱긋 웃으며 말한다.
			<</switch>>
		<<else>>
			<<switch $_rng>>
				<<case 1>> "날 잡지 못할걸," 당신이 말한다.
				<<case 2>> "먼저 날 잡아야 할 거야," 당신이 말한다.
				<<case 3>> "뭔가 시도해보고 싶다면," 당신이 입을 연다. "먼저 날 잡아야 할 거야."
				<<case 4>> "내 앞가림 정도는 할 줄 알거든," 당신이 말한다. "잡을 수 있으면 잡아봐."
				<<case 5>> "계속 움직여," 당신이 말한다. "아니면 도망쳐버릴 테니까."
			<</switch>>
		<</if>>
	<</if>>
	<<if $feetuse isnot "run">>
		당신은 달리기 시작한다.
	<</if>>
<</widget>>

<<widget "actionsconfrontNNPC">>
	<<if $wraith and $wraith.mimic>>
		<<set $_npc to $wraith.mimic>>
	<<else>>
		<<set $_npc to $NPCList[0].fullDescription>>
	<</if>>
	<<if isLoveInterest($_npc) and random(1)>>
		<<if $speech_attitude is "meek">>
			"너, 너 맞니, <<print window.KR.getDescriptionKr($_npc)>>?" 당신이 묻는다.
		<<elseif $speech_attitude is "bratty">>
			"뭘 원해, <<print window.KR.getDescriptionKr($_npc)>>?" 당신이 쏘아붙인다.
		<<else>>
			"<<print window.KR.getDescriptionKr($_npc)>>?" 당신이 말한다.
		<</if>>
	<<else>>
		<<switch $_npc>>
			<<case "Whitney">>
				<<if $whitneyromance is 1>>
					<<if $speech_attitude is "meek">>
						<<switch random(1, 3)>>
							<<case 3>> 당신은 꿀꺽 침을 삼킨다. "날 괴롭히려는 건 아니지, 응?"
							<<case 2>> "네 <<girlfriend>>【을를】 상처 입히진 않을 거지." 당신이 말을 더듬는다. "그-그렇지?"
							<<case 1>> "살살해줘, 휘트니..." 당신이 애원한다.
						<</switch>>
					<<elseif $speech_attitude is "bratty">>
						<<switch random(1, 3)>>
							<<case 3>> "우리가 사귄다고 해서 날 함부로 대할 수 있다고 생각하지 마." 당신이 말한다.
							<<case 2>> "난 누구의 소유물도 아니야." 당신이 말한다. "특히 네 것은 더더욱."
							<<case 1>> "수다 떨려고 여기까지 온 건 아닐 텐데." 당신이 말한다.
						<</switch>>
					<<else>>
						<<switch random(1, 3)>>
							<<case 3>> "네 <<girlfriend>>【을를】 상처 입히진 않을 거지." 당신이 말한다.
							<<case 2>> "네가 뭘 원하는지 알아." 당신이 한숨을 쉰다.
							<<case 1>> "난 장난감이 아니야." 당신이 말한다.
						<</switch>>
					<</if>>
				<<else>>
					<<if $speech_attitude is "meek">>
						<<switch random(1, 3)>>
							<<case 3>> 당신은 고개를 숙인다. "그냥... 너무 거칠게만 하지 마."
							<<case 2>> "제발," 당신이 말한다. "나 좀 내버려 둬!"
							<<case 1>> "괴롭힘당하지 않을 거야." 당신이 중얼거린다.
						<</switch>>
					<<elseif $speech_attitude is "bratty">>
						<<switch random(1, 3)>>
							<<case 3>> "조심해." 당신이 경고한다. "주변에 널 구해줄 선생은 아무도 없어."
							<<case 2>> "네 찌질한 친구들한테나 기어 돌아가지 그래?" 당신이 말한다.
							<<case 1>> "무슨 짓이든 해봐, 네 엉덩이를 걷어차 줄 테니." 당신이 말한다.
						<</switch>>
					<<else>>
						<<switch random(1, 3)>>
							<<case 3>> "네가 날 괴롭히게 놔두지 않을 거야." 당신이 말한다.
							<<case 2>> "뭘 증명하고 싶은 건데?" 당신이 말한다.
							<<case 1>> "감히 어딜." 당신이 말한다.
						<</switch>>
					<</if>>
				<</if>>
			<<case "Eden">>
				<<if $syndromeeden is 1>>
					<<if $speech_attitude is "meek">>
						<<switch random(1, 3)>>
							<<case 3>> 당신은 아래를 내려다본다. "나한테 화났어...?"
							<<case 2>> "에덴, 너 무서워." 당신이 훌쩍인다.
							<<case 1>> 당신은 꿀꺽 침을 삼킨다. "왜-왜 날 사냥감처럼 쳐다보는 거야?"
						<</switch>>
					<<elseif $speech_attitude is "bratty">>
						<<switch random(1, 3)>>
							<<case 3>> "여기서 대체 뭐 하는 거야?" 당신이 쏘아붙인다.
							<<case 2>> "집에 가고 싶을 때 갈 거야." 당신이 말한다.
							<<case 1>> "무슨 고깃덩어리처럼 쳐다보지 마." 당신이 쏘아붙인다.
						<</switch>>
					<<else>>
						<<switch random(1, 3)>>
							<<case 3>> "집에서 꽤 멀리 왔네." 당신이 말한다.
							<<case 2>> "여기서 뭐 하는 거야?" 당신이 묻는다.
							<<case 1>> "얼마나 날 따라온 거야?" 당신이 묻는다.
						<</switch>>
					<</if>>
				<<else>>
					<<if $speech_attitude is "meek">>
						<<switch random(1, 3)>>
							<<case 3>> "저리 가!" 당신이 운다. "무섭단 말이야!"
							<<case 2>> "제발 쏘지 마세요!" 당신이 운다.
							<<case 1>> "난 동물이 아니야!" 당신이 운다.
						<</switch>>
					<<elseif $speech_attitude is "bratty">>
						<<switch random(1, 3)>>
							<<case 3>> "난 누구의 사냥감도 아니야." 당신이 으르렁거린다.
							<<case 2>> "네 더러운 낡은 오두막으로나 돌아가." 당신이 짖는다.
							<<case 1>> "더 가까이 오기만 해." 당신이 말한다. "그 총을 <<if $settings.analEnabled>>네 똥구멍에<<else>>네 목구멍에<</if>> 쑤셔 박아줄 테니."
						<</switch>>
					<<else>>
						<<switch random(1, 3)>>
							<<case 3>> "총 내려놔." 당신이 말한다.
							<<case 2>> "사슴이나 쫓으러 돌아가." 당신이 말한다.
							<<case 1>> "난 무력한 동물이 아니야." 당신이 말한다.
						<</switch>>
					<</if>>
				<</if>>
			<<case "Ivory Wraith">>
				<<if $wraith.state is "haunt" and $wraithPrison and $wraithPrison.vision>>
					<<if $speech_attitude is "meek">>
						<<switch random(1, 3)>>
							<<case 3>> 당신은 운다. "미안해! 그냥 날 내버려 둬!"
							<<case 2>> "왜 그냥 내버려 둘 수가 없는 거야?" 당신이 묻는다.
							<<case 1>> 당신은 아래를 내려다본다. "제발 날 그만 괴롭혀."
						<</switch>>
					<<elseif $speech_attitude is "bratty">>
						<<switch random(1, 3)>>
							<<case 3>> "네 그 멍청한 목걸이, 나한테 없어." 당신이 말한다.
							<<case 2>> "여기 우리가 서 있으니, 돌려줘." 당신이 조롱한다. "꺼져."
							<<case 1>> "호수로 돌아가!" 당신이 소리친다.
						<</switch>>
					<<else>>
						<<switch random(1, 3)>>
							<<case 3>> "이거 목걸이 때문이야?" 당신이 묻는다.
							<<case 2>> "왜 그렇게 나한테 집착하는 거야?" 당신이 묻는다.
							<<case 1>> 당신은 한숨을 쉰다. "또 너구나."
						<</switch>>
					<</if>>
				<<else>>
					<<if $speech_attitude is "meek">>
						<<switch random(1, 3)>>
							<<case 3>> 당신은 운다. "무섭단 말이야!"
							<<case 2>> "왜... 떠 있는 거야?" 당신이 묻는다.
							<<case 1>> 당신은 말하려고 하지만, 그것의 <<wraithEyes>> 눈이 당신을 꿰뚫자 목이 굳어버린다.
						<</switch>>
					<<elseif $speech_attitude is "bratty">>
						<<switch random(1, 3)>>
							<<case 3>> "저리 가, 이 창백한 괴물아." 당신이 뱉어낸다.
							<<case 2>> "허공이 이렇게 못생길 수 있다는 건 처음 알았네." 당신이 조롱한다.
							<<case 1>> "넌 대체 정체가 뭐야?" 당신이 말한다. "이상한 빌어먹을 생물 같으니."
						<</switch>>
					<<else>>
						<<switch random(1, 3)>>
							<<case 3>> "난 무슨 희생양이 아니야." 당신이 말한다.
							<<case 2>> "난 네가 무섭지 않아." 당신이 <<if $controlled>>말한다<<else>>거짓말한다<</if>>.
							<<case 1>> "네가 날 괴롭히게 두지 않을 거야." 당신이 말한다.
						<</switch>>
					<</if>>
				<</if>>
			<<case "Gwylan">>
				<<if $gwylan.taken>>
					<<if $speech_attitude is "meek">>
						"더 이상 네가 날 돌봐줄 필요 없어." 당신이 말한다.
					<<elseif $speech_attitude is "bratty">>
						"가까이 오지 마. 내 머릿속에서도 나가." 당신이 말한다.
					<<else>>
						"날 내버려 둬, 그윌란!"
					<</if>>
				<<else>>
					<<if $speech_attitude is "meek">>
						<<switch random(1, 3)>>
							<<case 3>> "제발 날 스튜로 만들지 마." 당신이 말한다.
							<<case 2>> "제발 날 개구리로 만들지 마." 당신이 말한다.
							<<case 1>> "제발 그만 따라다녀, 그윌란." 당신이 말한다.
						<</switch>>
					<<elseif $speech_attitude is "bratty">>
						<<switch random(1, 3)>>
							<<case 3>> "그만 좀 따라다니지 그래, 그윌란?"
							<<case 2>> "날 내버려 둬, 이 마녀야!"
							<<case 1>> "늑대나 쫓으러 가." 당신이 말한다.
						<</switch>>
					<<else>>
						<<switch random(1, 3)>>
							<<case 3>> "도와줄까, 그윌란?"
							<<case 2>> "왜 날 따라오는 거야?"
							<<case 1>> "네가 불안하게 만들잖아, 그윌란."
						<</switch>>
					<</if>>
				<</if>>
			<<default>>
				<<actionsconfront>>
		<</switch>>
	<</if>>
<</widget>>
<<widget "actionstauntNNPC">>
	<<if $wraith and $wraith.mimic>>
		<<set $_npc to $wraith.mimic>>
	<<else>>
		<<set $_npc to $NPCList[0].fullDescription>>
	<</if>>
	<<switch $_npc>>
		<<case "Eden">>
			<<if $syndromeeden is 1>>
				<<if $speech_attitude is "meek">>
					<<switch random(1, 3)>>
						<<case 3>> "나한테 화난 거야? 계속 도망가면 더 화낼 거야?"
						<<case 2>> "에덴, 무서워," 당신이 장난스레 훌쩍인다.
						<<case 1>> 당신은 침을 꿀꺽 삼킨다. "나를 꼭 사냥감 보듯이 보고 있네. 그, 그 말인즉슨 내가..."
					<</switch>>
				<<elseif $speech_attitude is "bratty">>
					<<switch random(1, 3)>>
						<<case 3>> "그렇게 쉽게 돌아가지는 않을 거야," 당신이 싱긋 웃으며 말한다.
						<<case 2>> "내가 집으로 돌아가길 원한다면, 먼저 날 잡아야 할걸," 당신이 말한다.
						<<case 1>> "나를 무슨 고깃덩어리 보듯이 쳐다보는 것 좀 그만둬," 당신이 요구한다.
					<</switch>>
				<<else>>
					<<switch random(1, 3)>>
						<<case 3>> "집에서 꽤 멀리 떨어졌네," 당신이 말한다. "날 다시 잡을 수 있을 거 같아?"
						<<case 2>> "여기 밖에서 뭐하고 있어?" 당신이 묻는다. "날 다시 잡을 수 있을 거 같아?"
						<<case 1>> "날 다시 잡을 수 있을 거 같아?" 당신이 묻는다.
					<</switch>>
				<</if>>
				<<if $feetuse isnot "run">>
					당신은 달리기 시작한다.
				<</if>>
			<<else>>
				<<actionstaunt>>
			<</if>>
		<<case "Ivory Wraith">>
			<<if $wraith.state is "haunt" and $wraithPrison and $wraithPrison.vision>>
				"네 멍청한 목걸이 여기 있어," 당신이 말한다. "와서 가져가 봐."
			<<else>>
				<<if $speech_attitude is "meek">>
					<<switch random(1, 3)>>
						<<case 3>> 당신이 소리친다. "너 무섭게 왜 이래!"
						<<case 2>> "너 왜... 떠 있는 거야?" 당신이 묻는다.
						<<case 1>> 당신은 입을 열려 하지만, 그것의 <<wraithEyes>> 눈이 당신을 꿰뚫어 보자 목구멍이 턱 막힌다.
					<</switch>>
				<<elseif $speech_attitude is "bratty">>
					<<switch random(1, 3)>>
						<<case 3>> "저리 가, 이 창백한 괴물아," 당신이 내뱉는다.
						<<case 2>> "허공이 이렇게 흉측하게 생길 수 있는 줄은 몰랐네," 당신이 조롱한다.
						<<case 1>> "대체 넌 정체가 뭐야?" 당신이 말한다. "존나 이상한 괴물이네."
					<</switch>>
				<<else>>
					<<switch random(1, 3)>>
						<<case 3>> "난 희생양 따위가 아니야," 당신이 말한다.
						<<case 2>> "하나도 안 무서워," 당신이 <<if $controlled>>말한다<<else>>거짓말한다<</if>>.
						<<case 1>> "네가 날 맴돌게 내버려두지 않을 거야," 당신이 말한다.
					<</switch>>
				<</if>>
			<</if>>
			<<if $feetuse isnot "run">>
				당신은 달리기 시작한다.
			<</if>>
		<<case "Gwylan">>
			<<if $gwylan.taken>>
				<<if $speech_attitude is "meek">>
					"목줄이 풀린 모양이네," 당신은 요염하게 말한다. "와서 잡아봐."
				<<elseif $speech_attitude is "bratty">>
					"날 네 장식품 중 하나로 간직하고 싶다면, 먼저 날 잡아야 할걸!"
				<<else>>
					"위험한 곳에 빠지기 전에 날 잡는 게 좋을 텐데," 당신이 말한다.
				<</if>>
			<<else>>
				<<if $speech_attitude is "meek">>
					<<switch random(1, 3)>>
						<<case 3>> "조금 먼저 출발하게 해 줘도 괜찮지?"
						<<case 2>> "살살 해줘, 그윌란. 난 달리기를 잘 못 한단 말이야."
						<<case 1>> "와서 날 잡아 봐, 그윌란!"
					<</switch>>
				<<elseif $speech_attitude is "bratty">>
					<<switch random(1, 3)>>
						<<case 3>> "<<if $location is "forest">>네가 이 숲을 얼마나 잘 아는지 한 번 볼까.<<else>>여기서도 숲에서처럼 날쌘지 한 번 볼까.<</if>>"
						<<case 2>> "네가 몰래 다가온다고 생각했겠지만, 냄새로 다 알고 있었어."
						<<case 1>> "아무도 날 잡지 못할걸!"
					<</switch>>
				<<else>>
					<<switch random(1, 3)>>
						<<case 3>> "추격전 한 판 할래?"
						<<case 2>> "우린 어디로 가게 될까, 궁금하네?"
						<<case 1>> "와서 날 잡아 봐."
					<</switch>>
				<</if>>
			<</if>>
			<<if $feetuse isnot "run">>
				당신은 달리기 시작한다.
			<</if>>
		<<default>>
			<<actionstaunt>>
	<</switch>>
<</widget>>
