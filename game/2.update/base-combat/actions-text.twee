		<</if>>
	<</if>>
<</widget>>

<<widget "actionsStroke">>
	<<if _args.length lte 0>>
		<<error {
			message	: "Missing parameters for <<actionsStroke>> ",
			source	: "Called from: " + Utils.GetStack()
		}>>
	<</if>>
	<<if $enemytype is "beast">>
		당신은 <<beasttype>>의 머리를 쓰다듬는다.
	<<else>>
		당신은
		<<if _args.length is 2 and _args[0] isnot _args[1]>>
			<<personselect _args[0]>><<persons>>【와과】 <<personselect _args[1]>><<persons>>
		<<elseif $enemyno lte 1>>
			<<personselect _args[0]>><<his>>
		<<else>>
			<<personselect _args[0]>><<persons>>
		<</if>>
		피부를 ?stroke.
	<</if>>
<</widget>>

<<widget "actionshit">>
	<<if _args[0] is "both">>
		<<set _hand to "양 손">>
		<<set $_target to $lefttarget>>
	<<else>>
		<<set _hand to "손">>
		<<if _args[0] isnot undefined>>
			<<set $_target to _args[0]>>
		<<else>>
			<<set $_target to 0>>
		<</if>>
	<</if>>
	<<if $enemytype is "beast">>
		<<if $pain lte 20>>
			당신은 _hand【을를】 휘둘러 <<beasttype>>【을를】 때린다.
		<<elseif $pain lte 60>>
			당신은 고통을 이겨내고 _hand【을를】 휘둘러 <<beasttype>>【을를】 때린다.
		<<else>>
			고통과 공포에 질려, 당신은 <<beasttype>>에게 마구 팔을 휘두른다.
		<</if>>
	<<else>>
		<<if $pain lte 20>>
			당신은 _hand【을를】 휘둘러 <<someone $_target>>【을를】 때린다.
		<<elseif $pain lte 60>>
			당신은 고통을 이겨내고 _hand【을를】 휘둘러 <<someone $_target>>【을를】 때린다.
		<<else>>
			고통과 공포에 질려, 당신은 자기방어를 위해 마구 팔을 휘두른다.
		<</if>>
	<</if>>
<</widget>>

<<widget "actionsclitstroke">>
