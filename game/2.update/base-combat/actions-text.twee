<<widget "actionsforgive">>
	<<checkforloveinterests>>
	<<if $enemytype is "beast">>
		"You don't know any better. You're just a <<beasttype>>," you say. "I forgive you."
	<<else>>
		<<if _loveInterest isnot undefined>> 
			/* Removing RNG since it's straightforward. Might add `and random(0, 100) lte 15` back if the situation calls for it */
			<<set $speechnamedrop to $npc.includes(_loveInterest) ? 0 : 1>>
			<<rng>>
			<<switch _loveInterest>>
				<<case "Avery">>
					<<if $npc.includes("Avery")>>
						<<if $avery_fate is undefined>>
							"You're just angry," you say. "Everyone gets angry sometimes. I forgive you."
						<<else>>
							"Now I understand why you get so angry, Avery," you say. "And I forgive you."
						<</if>>
					<</if>>
				<<default>>
					"Even though you're doing such a horrible thing, don't worry," you say. "I forgive you."
			<</switch>>
		<<else>>
			"Even though you're doing such a horrible thing, don't worry," you say. "I forgive you."
		<</if>>
	<</if>>
<</widget>>

