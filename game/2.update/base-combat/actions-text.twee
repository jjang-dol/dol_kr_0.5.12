<</widget>>

<<widget "penises">><<silently>>
	<!-- possible alternatives: ...-->
	<<if $arousal gte ($arousalmax / 5) * 4>>
		<<set _text_output to "기둥들">>
	<<elseif $arousal gte ($arousalmax / 5) * 3>>
		<<set _text_output to "발기한 자지들">>
	<<elseif $arousal gte ($arousalmax / 5) * 2>>
		<<set _text_output to "자지들">>
	<<elseif $arousal gte $arousalmax / 5>>
		<<set _text_output to "귀두들">>
	<<else>>
		<<set _text_output to "자지들">>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "pussies">><<silently>>
	<!-- possible alternatives: muffs, twats, slits, snatches, vulvas ...-->
	<<if $arousal gte ($arousalmax / 5) * 4>>
		<<set _text_output to "클리들">>
	<<elseif $arousal gte ($arousalmax / 5) * 3>>
		<<set _text_output to "보지들">>
	<<elseif $arousal gte ($arousalmax / 5) * 2>>
		<<set _text_output to "보지들">>
	<<elseif $arousal gte $arousalmax / 5>>
		<<set _text_output to "음부들">>
	<<else>>
		<<set _text_output to "질들">>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "actionsothervaginavaginarub">>
	<<if $enemytype is "beast">>
		<<if $arousal gte ($arousalmax / 5) * 4>>
			<<if $pain gte 40>>
				당신은 자신의 것으로 <<beasttypes>> 보지를 <<vaginaltext>> 조심스럽게 문지른다.
			<<else>>
				당신은 자신의 것으로 <<beasttypes>> 보지를 <<vaginaltext>> 문지른다.
			<</if>>
		<<else>>
			<<if $pain gte 40>>
				당신은 자신의 것으로 <<beasttypes>> 보지에 <<vaginaltext>> 조심스럽게 입 맞춘다.
			<<else>>
				당신은 자신의 것으로 <<beasttypes>> 보지에 <<vaginaltext>> 입 맞춘다.
			<</if>>
		<</if>>
	<<else>>
		<<if $arousal gte ($arousalmax / 5) * 4>>
			<<if $pain gte 40>>
				당신은 서로의 <<pussies>>【을를】 <<vaginaltext>> 문지른다.
			<<else>>
				당신은 서로의 <<pussies>>【을를】 <<vaginaltext>> 비벼댄다.
			<</if>>
		<<else>>
			<<if $pain gte 40>>
				당신은 <<pussy>>【을를】 <<their _args[0]>> 것에 <<vaginaltext>> 문지른다.
			<<else>>
				당신은 자신의 것으로 <<their _args[0]>> 보지에 <<vaginaltext>> 입 맞춘다.
			<</if>>
		<</if>>
	<</if>>
<</widget>>

