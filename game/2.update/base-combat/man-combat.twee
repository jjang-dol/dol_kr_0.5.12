			<<case "midriff">>
				<<He>>【이가】 <<print ($_hand is "left" ? "오른손" : "왼손")>>으로 당신의 $_clothing.name【을를】 걷어 올려, 당신의 복부를 노출시킨다.
				<<neutral 1 _n>>
				<<if playerBellyVisible()>><<set $speechpregnant to 1>><</if>>
			<<case "chest">>
				<<if _toplessExposed>>
					<<He>>【이가】 <<print ($_hand is "left" ? "오른손" : "왼손")>>으로 당신의 $_clothing.name【을를】 걷어 올려, <span class="lewd">당신의 <<breasts>>【을를】 노출시킨다.</span>
					<<neutral 2 _n>><<set $speechbreasts to 1>>
				<<else>>
					<<He>>【이가】 <<print ($_hand is "left" ? "오른손" : "왼손")>>으로 당신의 $_clothing.name【을를】 가슴 위로 걷어 올려, 당신의 <<exposedupper>>【을를】 노출시킨다.
					<<neutral 1 _n>>
				<</if>>
			<<case 0>>
				<span class="purple"><<He>>【이가】 <<print ($_hand is "left" ? "오른손" : "왼손")>>으로 당신의 $_clothing.name【을를】 완전히 벗겨낸다.</span>
