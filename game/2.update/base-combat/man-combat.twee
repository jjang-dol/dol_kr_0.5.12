	<</if>>
<</widget>>

<<widget "combat-hand-on-anusentrance">>
	<<rng>>
	<<if $rng gte 101>>
		<span class="blue"><<He>>【이가】 당신의 항문에서 손을 뗀다.</span>
		<<combat-reset-hand _args[0]>>
		<<set $anususe to 0>>
	<<elseif playerHasButtPlug()>>
		<<if $rng gte 21 or $noanal is 1 or $cheekaction is "handrub">>
			<<print either(
				`<<He>>【이가】 당신의 $worn.butt_plug.name【을를】 밀어 넣었다 빼며 당신의 항문을 애태운다.`,
				`<<He>>【이가】 당신의 $worn.butt_plug.name【을를】 밀어 넣었다 빼며 당신의 항문을 애태운다.`,
				`<<He>>【이가】 당신의 엉덩이와 $worn.butt_plug.name【을를】 철썩 때린다.`
			)>>
			<<set $anususe to "hand">>
			<<set $anusstate to "handentrance">>
		<<else>>
			<<set $worn.butt_plug.state to "removed">>
			<<his>> <<print _args[0] is "left" ? "왼손" : "오른손">>【으로로】,
			<<if random(0,2) isnot 0>>
				<<he>>【이가】 당신의 $worn.butt_plug.name【을를】 빼낸다.
				<<set $anususe to "hand">>
				<<set $anusstate to "handentrance">>
			<<else>>
				<<he>>【이가】 당신의 $worn.butt_plug.name【을를】 빼내고 손을 치운다.
				<<combat-reset-hand $_hand>><<neutral 5 _n>>
			<</if>>
		<</if>>
		<<set $anususe to "hand">>
		<<set $anusstate to "handentrance">>
		<<neutral 10 _n>>
		<<bodypart_admire_chance random_bottom>>
	<<elseif $rng gte 21 or $noanal is 1 or $cheekaction is "handrub">>
		<<He>>【이가】 당신의 항문을 <<strokes>>
		<<set $anususe to "hand">>
		<<set $anusstate to "handentrance">>
		<<neutral 10 _n>>
		<<bodypart_admire_chance random_bottom>>
	<<elseif $rng lte 20 and $noanal is 0 and $cheekaction isnot "handrub">>
		<span class="pink"><<He>>【이가】 손가락을 당신의 항문 속으로 깊숙이 쑤셔 넣는다.</span>
		<<combat-set-hand-target _args[0] "anus">>
		<<set $anususe to "hand">>
		<<set $anusstate to "handentrance">>
		<<neutral 15 _n>>
		<<set $speechanus to 1>>
		<<bodypart_admire_chance random_bottom>>
	<</if>>
<</widget>>

<<widget "combat-hand-on-bottom">>
	<<rng>>
