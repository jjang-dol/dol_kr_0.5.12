				<<if $enemyanger lte 20>>
					<<addinlineevent "avery_speech_dungeon_out_lowanger_rape" 1>>
						"I think you're due a visit to the dungeon, <<pcpetname "Avery">>." <<He>> gives you an unpleasant smile. "It's clearly been too long if you're acting up like this."
					<</addinlineevent>>
				<<elseif $enemyanger lte 100>>
					<<addinlineevent "avery_speech_dungeon_out_midanger_rape" 1>>
						"I ought to take you to the dungeon more often—clearly you need to be taught some discipline," <<he>> <<= either("snarls","growls")>>.
					<</addinlineevent>>
				<<else>>
					<<addinlineevent "avery_speech_dungeon_out_highanger_rape" 1>>
						"I'll make you regret this the next time I have you in the dungeon, <<girl>>!"
					<</addinlineevent>>
				<</if>>
			<</if>>
		<</if>>
	<</if>>

	/* Random events */
	<<if C.npc.Avery.rage gte 60>>
		<<if $consensual>>
			<<if C.npc.Avery.love gte 60>>
				<<addinlineevent "avery_speech_gen_hirage_hilove_sex_1" 1>>
					"It's truly a shame a <<cute>> thing like you is almost more trouble than you're worth..."
				<</addinlineevent>>
				<<addinlineevent "avery_speech_gen_hirage_hilove_sex_2" 1>>
					"Don't forget that you're mine, <<pcpetname "Avery">>."
				<</addinlineevent>>
			<<else>>
				<<addinlineevent "avery_speech_gen_hirage_sex_1" 1>>
					"Time to remind you what your purpose is..."
				<</addinlineevent>>
				<<addinlineevent "avery_speech_gen_hirage_sex_2" 1>>
					"You're lucky I've still an ounce of leniency in me yet."
				<</addinlineevent>>
				<<addinlineevent "avery_speech_gen_hirage_sex_3" 1>>
					"Behave yourself and maybe you'll be a step closer to earning my forgiveness."
				<</addinlineevent>>
				<<addinlineevent "avery_speech_gen_hirage_sex_4" 1>>
					"Be a good <<girl>>, and it will all be over soon."
				<</addinlineevent>>
				<<addinlineevent "avery_speech_gen_hirage_sex_5" 1>>
					<<He>> doesn't say anything, just stares at you coldly.
				<</addinlineevent>>
				<<addinlineevent "avery_speech_gen_hirage_sex_6" 1>>
					"I wonder sometimes if you act out just to end up here."
				<</addinlineevent>>
				<<addinlineevent "avery_speech_gen_hirage_sex_7" 1>>
					"You're forgiven a little more with every sound you make. Keep going."
				<</addinlineevent>>
				<<addinlineevent "avery_speech_gen_hirage_sex_8" 1>>
					"Good <<girl>>. See how much better things go when you stop fighting me?"
				<</addinlineevent>>
				<<addinlineevent "avery_speech_gen_hirage_sex_9" 1>>
					"You're going to think about this the next time you decide to defy me."
				<</addinlineevent>>
				<<addinlineevent "avery_speech_gen_hirage_sex_10" 1>>
					"You have no idea what you do to me. It's deeply inconvenient."
				<</addinlineevent>>
			<</if>>
		<<else>>
			<<if $enemyhealth gte $enemyhealthmax or $enemyanger lte 20>>
				<<addinlineevent "avery_speech_gen_hirage_rape_calm_1" 1>>
					<<He>> gives you a stern look. "You'd best not defy me, <<pcpetname "Avery">>." 
				<</addinlineevent>>
				<<addinlineevent "avery_speech_gen_hirage_rape_calm_2" 1>>
					"Enough with your disobedience, <<girl>>."
				<</addinlineevent>>
				<<addinlineevent "avery_speech_gen_hirage_rape_calm_3" 1>>
					"Keep resisting me, and I'll make you regret it. I'm already tempted enough as it is."
				<</addinlineevent>>
				<<addinlineevent "avery_speech_gen_hirage_rape_calm_4" 1>>
					<<He>> <<laughs>> derisively. "Don't act as if you don't want this, <<pcpetname "Avery">>." 
				<</addinlineevent>>
				<<addinlineevent "avery_speech_gen_hirage_rape_calm_5" 1>>
					"Obey me, or you'll regret it. My patience is not unending, <<girl>>."
				<</addinlineevent>>
				<<addinlineevent "avery_speech_gen_hirage_rape_calm_6" 1>>
					"You're on thin ice, <<pcpetname "Avery">>." <<He>> flashes a mean smirk. "But it's not too late to make it up to me."
				<</addinlineevent>>
				<<addinlineevent "avery_speech_gen_hirage_rape_calm_7" 1>>
					"Don't you know that I own you?"
				<</addinlineevent>>
			<<elseif $enemyhealth gte $enemyhealthmax / 2 or $enemyanger lte 100>>
				<<addinlineevent "avery_speech_gen_hirage_rape_struggle_1" 1>>
					"I'd think carefully about the price of defying me."
				<</addinlineevent>>
				<<addinlineevent "avery_speech_gen_hirage_rape_struggle_2" 1>>
					"<<= $avery_fate is "saved" ? "Apologise, behave" : "Behave">> yourself, and maybe you can still earn my forgiveness."
				<</addinlineevent>>
				<<addinlineevent "avery_speech_gen_hirage_rape_struggle_3" 1>>
					"You really enjoy testing my patience like this? Big mistake."
				<</addinlineevent>>
				<<addinlineevent "avery_speech_gen_hirage_rape_struggle_4" 1>>
					"If you insist on defying me, then you're just asking to be punished!"
				<</addinlineevent>>
				<<addinlineevent "avery_speech_gen_hirage_rape_struggle_5" 1>>
					"I promise that you don't want to make me your enemy," <<he>> says with a threatening glint in <<his>> eye
				<</addinlineevent>>
				<<addinlineevent "avery_speech_gen_hirage_rape_struggle_6" 1>>
					"Classless trash like you ought to be glad for my attention, so act like it!"
				<</addinlineevent>>
			<<else>>
				<<addinlineevent "avery_speech_gen_hirage_rape_resist_1" 1>>
					"This is only your just desserts, you uppity little <<= either("slut","bitch","shit","whore","tramp","fucktoy","wretch","guttersnipe")>>!"
				<</addinlineevent>>
				<<addinlineevent "avery_speech_gen_hirage_rape_resist_2" 1>>
					"Behave!" <<he>> growls.
				<</addinlineevent>>
				<<addinlineevent "avery_speech_gen_hirage_rape_resist_3" 1>>
					"I've had it with your bullshit," <<he>> hisses. "Stay still if you know what's good for you!"
				<</addinlineevent>>
				<<addinlineevent "avery_speech_gen_hirage_rape_resist_4" 1>>
					"I'm sick and tired of your disobedience!"
				<</addinlineevent>>
				<<addinlineevent "avery_speech_gen_hirage_rape_resist_5" 1>>
					"You worthless fucking <<= either("trash","tramp","wretch","guttersnipe")>>!"
				<</addinlineevent>>
				<<addinlineevent "avery_speech_gen_hirage_rape_resist_6" 1>>
					"Just stay still and take it, you filthy little <<= either("slut","bitch","whore","tramp","fucktoy")>>!"

				<</addinlineevent>>
			<</if>>
		<</if>>
	<<elseif C.npc.Avery.rage gte 20>>
		<<if C.npc.Avery.love gte 60>>
			<<addinlineevent "avery_speech_gen_midrage_hilove_sex_1" 1>>
				"If only we had time for more than this... A shame."
			<</addinlineevent>>
			<<addinlineevent "avery_speech_gen_midrage_hilove_sex_2" 1>>
				"So <<cute>>...and all mine."
			<</addinlineevent>>
		<<else>>
			<<addinlineevent "avery_speech_gen_midrage_sex_1" 1>>
				"You had better behave yourself. I don't want to have to punish you, <<pcpetname "Avery">>."
			<</addinlineevent>>
			<<addinlineevent "avery_speech_gen_midrage_sex_2" 1>>
				"You're not a bad <<girl>>, are you?"
			<</addinlineevent>>
			<<addinlineevent "avery_speech_gen_midrage_sex_3" 1>>
				"You're <<cute>>, but you'll need more than this if you want my forgiveness."
			<</addinlineevent>>
			<<addinlineevent "avery_speech_gen_midrage_sex_4" 1>>
				"I needed this..."
			<</addinlineevent>>
			<<addinlineevent "avery_speech_gen_midrage_sex_5" 1>>
				"At least you're good for something."
			<</addinlineevent>>
			<<addinlineevent "avery_speech_gen_midrage_sex_6" 1>>
				"There. See? You can be good when you want to be."
			<</addinlineevent>>
			<<addinlineevent "avery_speech_gen_midrage_sex_7" 1>>
				"I'd really rather not have to be angry with you, <<pcpetname "Avery">>."
			<</addinlineevent>>
			<<addinlineevent "avery_speech_gen_midrage_sex_8" 1>>
				"This is all I wanted from you today. Was that so hard?"
			<</addinlineevent>>
			<<addinlineevent "avery_speech_gen_midrage_sex_9" 1>>
				"Don't make me regret going easy on you."
			<</addinlineevent>>
			<<addinlineevent "avery_speech_gen_midrage_sex_10" 1>>
				"You're fortunate I'm so fond of you."
			<</addinlineevent>>
		<</if>>
	<<else>>
		<<if C.npc.Avery.love gte 60>>
			<<addinlineevent "avery_speech_gen_lowrage_hilove_sex_1" 1>>
				"You seem so fragile like this. <<= $speech_attitude is "meek" or $speech_attitude_avery ? "More so than usual" : $speech_attitude is "bratty" ? "Unlike usual" : "It's quite charming">>..."
			<</addinlineevent>>
			<<if isAveryMansionUnlocked()>>
				<<addinlineevent "avery_speech_gen_lowrage_hilove_sex_mansion" 1>>
					"I might want another round after this," <<he>> says with a breathy laugh.<</addinlineevent>>
			<<else>>
				<<addinlineevent "avery_speech_gen_lowrage_hilove_sex_nomansion" 1>>
					"Be careful, <<pcpetname "Avery">>, or I'll want to keep you," <<he>> teases with a breathy laugh.
				<</addinlineevent>>
			<</if>>
		<<else>>
			<<addinlineevent "avery_speech_gen_lowrage_sex_1" 1>>
				<<He>> murmurs, "I wonder..." But <<he>> doesn't finish the thought, just <<= either("smirks lecherously","smiles secretively")>> at you.
			<</addinlineevent>>
			<<addinlineevent "avery_speech_gen_lowrage_sex_2" 1>>
				"Oh, I could just eat you up..."
			<</addinlineevent>>
			<<addinlineevent "avery_speech_gen_lowrage_sex_3" 1>>
				"What sweet sounds..."
			<</addinlineevent>>
			<<addinlineevent "avery_speech_gen_lowrage_sex_4" 1>>
				"Good <<girl>>..."
			<</addinlineevent>>
			<<addinlineevent "avery_speech_gen_lowrage_sex_5" 1>>
				"Memories of you like this will tide me over the next time I'm <<= either("swamped with paperwork","stuck in traffic","forced to sit through another boring meeting")>>... For a while, at least."
			<</addinlineevent>>
			<<addinlineevent "avery_speech_gen_lowrage_sex_6" 1>>
				"How did I ever manage without you..."
			<</addinlineevent>>
			<<addinlineevent "avery_speech_gen_lowrage_sex_7" 1>>
				"I don't think I'll ever tire of this."
			<</addinlineevent>>
			<<addinlineevent "avery_speech_gen_lowrage_sex_8" 1>>
				"I've been thinking about this all day, if you must know."
			<</addinlineevent>>
			<<addinlineevent "avery_speech_gen_lowrage_sex_9" 1>>
				"I picked well, didn't I?" <<he>> muses, an impish smile crossing <<his>> lips."
			<</addinlineevent>>
			<<addinlineevent "avery_speech_gen_lowrage_sex_10" 1>>
				"I've acquired many fine things in life. None of them look quite like this."
			<</addinlineevent>>
		<</if>>
	<</if>>

	<<runeventpool>>
<</widget>>

<<widget "averyTfComments">>
	<<set _tf to checkTFparts()>>
	<<set _tfWeight to 2>>
	<<if Object.keys(_tf).length isnot 0>>
		/* There's at least one transformation - TFs are for speech. There's no admire action yet */

		/* Angel */
		<<if $angel gte 6 and (_tf.angelHalo or _tf.angelWings)>>
			<<if $consensual>>
				<<addinlineevent "avery_speech_tf_angel_sex" _tfWeight>>
					"My innocent little angel..." <<He>> grins, and plucks a feather from one of your wings, making you gasp.
				<</addinlineevent>>
			<<else>>
				<<addinlineevent "avery_speech_tf_angel_rape" _tfWeight>>
					"My disobedient little angel..." <<He>> purses <<his>> lips, and pulls a feather from one of your wings, making you gasp.
				<</addinlineevent>>
			<</if>>
		<</if>>

		/* Demon */
		<<if $demon gte 6 and (_tf.demonHorns or _tf.demonWings or _tf.demonTail)>>
			<<if $consensual>>
				<<addinlineevent "avery_speech_tf_demon_sex" _tfWeight>>
					"My sinful little devil..." <<He>> smirks, and pulls on your tail, making you shiver.
				<</addinlineevent>>
			<<else>>
				<<addinlineevent "avery_speech_tf_demon_rape" _tfWeight>>
					"My defiant little devil..." <<He>> scowls, and yanks on your tail, making you jolt.
				<</addinlineevent>>
			<</if>>
		<</if>>

		/* Fallen Angel */
		<<if $fallenangel gte 0 and (_tf.fallenAngelHalo or _tf.fallenAngelWings)>>
			<<if $consensual>>
				<<addinlineevent "avery_speech_tf_fangel_sex" _tfWeight>>
					"My poor little angel..." <<He>> grins, and plucks a feather from one of your wings, making you gasp.
				<</addinlineevent>>
			<<else>>
				<<addinlineevent "avery_speech_tf_fangel_rape" _tfWeight>>
					"My wretched little angel..." <<He>> purses <<his>> lips, and plucks a feather from one of your wings, making you gasp.
				<</addinlineevent>>
			<</if>>
		<</if>>

		/* Cat */
		<<if $cat gte 6 and (_tf.catEars or _tf.catTail)>>
			<<if $consensual>>
				<<addinlineevent "avery_speech_tf_cat_sex" _tfWeight>>
					"My pretty little kitten..." <<He>> <<= either(
						"scratches behind one of your ears, making you shiver.", "pulls on your tail, making you gasp.","scratches underneath your chin, like a pet.")>>
				<</addinlineevent>>
			<<else>>
				<<addinlineevent "avery_speech_tf_cat_rape" _tfWeight>>
					"My temperamental little kitten..." <<He>> <<= either("tugs on one of your ears, making you yowl.", "pulls on your tail, making you jolt.")>>
				<</addinlineevent>>
			<</if>>
		<</if>>
		/* Wolf */
		<<if $wolfgirl gte 6 and (_tf.wolfEars or _tf.wolfTail)>>
			<<if $consensual>>
				<<addinlineevent "avery_speech_tf_wolf_sex" _tfWeight>>
					"My precious little puppy..." <<He>> <<= either("scratches behind one of your ears, making you shiver.","pulls on your tail, making you gasp.","scratches underneath your chin, like a pet.")>>
				<</addinlineevent>>
			<<else>>
				<<addinlineevent "avery_speech_tf_wolf_rape" _tfWeight>>
					"My ill-behaved little puppy..." <<He>> <<= either(
						"tugs on one of your ears, making you whimper.",
					"pulls on your tail, making you jolt.")>>
				<</addinlineevent>>
			<</if>>
		<</if>>
		/* Cow */
		<<if $cow gte 6 and (_tf.cowHorns or _tf.cowTail)>>
			<<if $consensual>>
				<<addinlineevent "avery_speech_tf_cow_sex" _tfWeight>>
					My cute little <<=$player.gender_appearance is "m" ? "bullboy" : "cowgirl">>..." <<He>> <<= either("scratches behind one of your ears, making you shiver.","pulls on your tail, making you gasp.","scratches underneath your chin, like a pet.")>>
				<</addinlineevent>>
			<<else>>
				<<addinlineevent "avery_speech_tf_cow_rape" _tfWeight>>
					My cute little <<=$player.gender_appearance is "m" ? "bullboy" : "cowgirl">>..." <<He>> <<= either("tugs on one of your ears, making you moo with pain.","pulls on your tail, making you jolt.")>>
				<</addinlineevent>>
			<</if>>
		<</if>>
		/* Fox */
		<<if $fox gte 6 and (_tf.foxEars or _tf.foxTail)>>
			<<if $consensual>>
				<<addinlineevent "avery_speech_tf_fox_sex" _tfWeight>>
					"My adorable little fox..." <<He>> <<= either("scratches behind one of your ears, making you shiver.","pulls on your tail, making you gasp.","scratches underneath your chin, like a pet.")>>
				<</addinlineevent>>
			<<else>>
				<<addinlineevent "avery_speech_tf_fox_rape" _tfWeight>>
					"My fickle little fox..." <<He>> <<= either("tugs on one of your ears, making you yip.","pulls on your tail, making you jolt.")>>
				<</addinlineevent>>
			<</if>>
		<</if>>
		/* Harpy */
		<<if $harpy gte 6 and (_tf.birdWings or _tf.birdTail or _tf.birdPlumage)>>
			<<if $consensual>>
				<<addinlineevent "avery_speech_tf_bird_sex" _tfWeight>>
					"My sweet little songbird..." <<He>> <<= either("pulls a feather from your plumage, making you gasp.","pulls a feather from your tail, making you whimper.","scratches underneath your chin, like a pet.")>>
				<</addinlineevent>>
			<<else>>
				<<addinlineevent "avery_speech_tf_bird_rape" _tfWeight>>
					"My wayward little songbird..." <<He>> <<= either("pulls a feather from your plumage, making you squawk.","pulls a feather from your tail, making you jolt.")>>
				<</addinlineevent>>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "averyCondomUseSpeech">>
	<<set _condomSpeechCase to _args[0]>>
	<<switch _condomSpeechCase>>
		<<case "accept" "acceptHas">>
			<<if $consensual>>
				<<if $averyragerevealed is 1 and C.npc.Avery.rage gte 60>>
					<<He_Short>> seems irritated at your request<<if C.npc.Avery.lust gte 60>>, looking like <<he>> wants to say no<</if>>. <span class="green"><<if playerPregnancyRisk() gte 3>>"Better safe than sorry," <<else>>"Fine," <</if>><<he>> says<<if C.npc.Avery.lust gte 60>> eventually<</if>></span>. "But don't presume to tell me what to do again, <<girl>>."<<if $NPCList[_n].lefthand is 0 or $NPCList[_n].righthand is 0>> <<He_Short>> <<= either("spanks your ass","slaps your thigh","smacks the back of your head")>> punitively.<</if>> "You're lucky I'm in a forgiving mood." <<set $enemyanger += 15>>
				<<elseif $averyragerevealed is 1 and C.npc.Avery.rage gte 20>>
					<<He_Short>> <<= either(`rolls <<his>> eyes`,`sighs`,`purses <<his>> lips`)>><<if C.npc.Avery.lust gte 60>>, looking reluctant<</if>>. <span class="green">"If you insist," <<he>> says<<if C.npc.Avery.lust gte 60>> eventually<</if>></span>.
				<<else>>
					"A condom?" <<He_Short>> hums<<if C.npc.Avery.lust gte 60>>, looking conflicted<</if>>. After a weighty pause<<if $averyragerevealed gte 1>> and a put upon sigh<</if>>, <<he>> nods. <span class="green">"Very well."</span>
				<</if>>
			<<else>>
				<<if C.npc.Avery.rage gte 60 or $enemyanger gt 100>>
					<<He_Short>> seems irritated at your request<<if C.npc.Avery.lust gte 60>>, looking like <<he>> wants to say no<</if>>. <span class="green">"I will," <<he>> says. "But not because you told me to, <<girl>>. <<if playerPregnancyRisk() gte 3>>Only because I don't want to be presented with a nuisance in the near future.<</if>>"</span><<if $NPCList[_n].lefthand is 0 or $NPCList[_n].righthand is 0>> <<He_Short>> <<= either("spanks your ass","slaps your thigh","smacks the back of your head")>> punitively.<</if>><<set $enemyanger += 15>>
				<<elseif C.npc.Avery.rage gte 20 or $enemyanger gt 20>>
					"You have some fucking nerve asking for that now," <<he>> snipes, narrowing <<his>> eyes at you.<<if C.npc.Avery.lust gte 60>> For a moment, it looks like <<he>> wants to say no.<</if>> <span class="green">"But fine."</span>
				<<else>>
					"A condom?" <<He_Short>> raises an eyebrow at you.<<if C.npc.Avery.lust gte 60>> <<Hes>> quiet long enough that you worry <<he>> intends to ignore your request, but finally says, <</if>><span class="green">"Fine. As a reward for good behavior."</span>
				<</if>>
			<</if>>
		<<case "acceptGive">>
			/*Replace or adjust me; I don't think you're supposed to reach it*/
			<<He_Short>> raises an eyebrow. "I'm usually prepared to that kind of situation, and yet for some reason, <span class="blue">they're nowhere to be found on my belongings</span>. Have you been cheating, <<pcpetname "Avery">>?"
		<<case "reject">>
			/*Replace or adjust me*/
			<span class="red"><<He_Short>> refuses!</span>
	<</switch>>
<</widget>>

<<widget "averyOralImminent">>
	<<if $consensual>>
		"I can't wait to taste you, <<pcpetname "Avery">>."
	<<else>>
		"Stay still, <<girl>>. You don't want me to bite, do you?"
	<</if>>
<</widget>>

<<widget "averySpeechDaddyChoke">>
	<<cleareventpool>>
	<<addinlineevent "avery_daddy_choke_classic" 0.5>>
		<<He>> <<laughs>>. "Let's see if you can still beg for <<nnpc_mummy "Avery">> with <<his>> hand around your throat."
	<</addinlineevent>>
	<<addinlineevent "avery_daddy_choke_variations" 2>>
		<<if C.npc.Avery.rage gte 60>>
			"I'll give you what you want," <<he>> murmurs darkly, "but not because you begged me to." <<His>> hand squeezes around your throat a little harder.
		<<elseif C.npc.Avery.rage gte 20>>
			"That's right, <<pcpetname "Avery">>." <<He>> <<laughs>> as <<his>> hand squeezes down a little harder. "Finally, you know how to speak to me."
		<<else>>
			"As you wish, <<pcpetname "Avery">>," <<he>> purrs. "Leave it to <<nnpc_mummy "Avery">>."
		<</if>>
	<</addinlineevent>>
	<<runeventpool>>
<</widget>>

<<widget "averyBodywritingSpeechOld">>
	<<switch $skin[_args[0]].special>>
		<<case "Avery">>
			<<switch $skin[_args[0]].writing>>
				<<case "Avery's Trophy">>
					<<if $averyragerevealed is 1 and C.npc.Avery.rage gte random(20, 100)>>
						<<He>> scoffs.
						<<set _text_output to "Don't flatter yourself.">>
						<<set $enemyanger += 20>><<set $enemytrust -= 20>><<npcincr Avery rage 1>>
					<<else>>
						<<if random(1)>>
							<<He>> raises an eyebrow.
							<<set _text_output to "You better keep behaving so perfectly.">>
						<<else>>
							<<He>> smiles.
							<<set _text_output to "It would be a shame not to show you off.">>
						<</if>>
						<<set $enemyanger -= 10>><<set $enemytrust += 10>><<npcincr Avery rage -1>>
					<</if>>
				<<case "Uptown Boy" "Uptown Girl">>
					<<if $averyragerevealed is 1 and C.npc.Avery.rage gte random(20, 100)>>
						<<He>> scoffs.
						<<set _text_output to "An urchin like you? As if.">>
						<<set $enemyanger += 20>><<set $enemytrust -= 20>><<npcincr Avery rage 1>>
					<<else>>
						<<He>> laughs.
						<<set _text_output to "One day you just might be.">>
						<<set $enemyanger -= 10>><<set $enemytrust += 10>><<npcincr Avery rage -1>>
					<</if>>
				<<case "Avery's Monopoly">>
					<<if $averyragerevealed is 1 and C.npc.Avery.rage gte random(20, 100)>>
						<<He>> sneers.
						<<set _text_output to "You're more of a subsidiary.">>
						<<set $enemyanger += 20>><<set $enemytrust -= 20>><<npcincr Avery rage 1>>
					<<else>>
						<<if random(1)>>
							<<He>> laughs.
							<<set _text_output to "Maybe we should play that lewd dice game some time.">>
						<<else>>
							<<He>> laughs.
							<<set _text_output to "What's next? Sole Shareholder?">>
						<</if>>
						<<set $enemyanger -= 10>><<set $enemytrust += 10>><<npcincr Avery rage -1>>
					<</if>>
				<<case "Endearing">>
					<<if $averyragerevealed is 1 and C.npc.Avery.rage gte random(20, 100)>>
						<<He>> scowls.
						<<set _text_output to "You're not as cute as you think.">>
						<<set $enemyanger += 20>><<set $enemytrust -= 20>><<npcincr Avery rage 1>>
					<<else>>
						<<His>> eyes soften.
						<<set _text_output to "You truly are, my dear.">>
						<<set $enemyanger -= 10>><<set $enemytrust += 10>><<npcincr Avery rage -1>>
					<</if>>
				<<default>>
					<<He>> cocks an eyebrow.
			<</switch>>
		<<default>>
			<<bodypart_admire_generic _args[0]>>
	<</switch>>
<</widget>>
