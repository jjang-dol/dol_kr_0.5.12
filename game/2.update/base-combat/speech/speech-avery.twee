	<<elseif $speechplead is 1>>
		<<switch $speechspecialdialogue>>
			<<case "avery_plead_mansion">> /* I'm sorry, Avery, please */
				<<if C.npc.Avery.rage gte 20 or $enemyanger gte 20>>
					"네 그 좆같은 사과는 필요 없어, 난 복종을 원한다고!"
				<<else>>
					"착한 펫처럼 내 아래에서 움츠러든 꼴이라니. 안타깝게도 난 지금 무자비한 기분이거든," <<he>>【이가】 가르랑거린다.
				<</if>>
			<<case "avery_plead_premansion">> /* Was this all the date was for...? */
				<<if C.npc.Avery.rage gte 20 or $enemyanger gte 20>>
					<<He>>【은는】 비웃는다. "네가 더 나은 대우를 받을 자격이 있다고 생각하나? 넌 딱 내가 주는 만큼만 받을 자격이 있어."
				<<else>>
					<<He>>【은는】 웃음을 터뜨린다. "그럼 뭘 기대한 거지, <<pcpetname "Avery">>? 동화 같은 이야기라도 바랐어?"
				<</if>>
			<<case "avery_plead_hunting_1">> /* Sorry I didn't mean to */
				<<if C.npc.Avery.rage gte 20 or $enemyanger gte 20>>
					"내 지능을 모욕하지 마," <<he>>【이가】 으르렁거린다. "넌 네가 무슨 짓을 하는지 정확히 알고 있었잖아!"
				<<else>>
					"이제 조용히 해. 착한 <<girl>>처럼 네 벌을 받아들여."
				<</if>>
			<<case "avery_plead_hunting_2">> /* I promise I'll do better */
				<<if C.npc.Avery.rage gte 20 or $enemyanger gte 20>>
					"내가 널 훈육해서 줄을 세워놔야 '더 잘' 하겠지!"
				<<else>>
					"당연히 더 잘하게 될 거야. 내가 직접 그렇게 만들 테니까," <<he>>【은는】 차갑게 미소 짓는다.
				<</if>>
			<<case "avery_plead_romance">> /* I love you, Avery */
				<<if C.npc.Avery.rage gte 20 or $enemyanger gte 20>>
					"감히 그 단어를 날 조종하는 데 쓰려고 하지 마," <<he>>【이가】 침을 뱉듯 말한다.
				<<else>>
					<<He>>【은는】 코웃음 친다. "날 진심으로 사랑했다면 내게 반항하지 않았겠지."
				<</if>>
		<</switch>>
	/* PC Moaning */
	<<elseif $speechmoan is 1>>
		<<switch $speechspecialdialogue>>
			<<case "avery_moan_default">> /* You're worth more than any payout */
				<<if C.npc.Avery.rage gte 60 >>
					<<He>>【은는】 비웃는다. "그래? 최근 네 행동을 보면 믿기 힘든데."
				<<elseif C.npc.Avery.rage gte 20>>
					<<He>>【은는】 능글맞게 웃는다. "알아. 하지만 네가 얌전히 굴기만 하면 돈은 계속 들어갈 거야, <<pcpetname "Avery">>."
				<<else>>
					<<He>>【은는】 <<= either("미소 짓는다","<<laughs>>")>>. "그렇게 느꼈니? 귀엽기도 하지."
				<</if>>
			<<case "avery_moan_ascended">> /* I'm all yours, Hound */
				<<if $consensual>>
					<<if C.npc.Avery.rage gte 60 >>
						<<His>> 두 눈이 잠시 커졌다가, 욕망으로 어두워진다. "그래, 넌 내 차지지." <<He>>【은는】 거만하게 <<= either("코웃음 친다","콧방귀를 뀐다")>>. "주제를 아는 건 좋은 일이야, 내 작은 여우."
					<<elseif C.npc.Avery.rage gte 20>>
						<<His>> 두 눈이 잠시 커졌다가, 욕망으로 어두워진다. "그렇지, 안 그래?" <<He>>【은는】 만족스러운 듯 능글맞게 웃는다. "주제를 아는 건 좋은 일이야, 내 작은 여우..."
					<<else>>
						<<His>> 두 눈이 잠시 커졌다가, 욕망으로 어두워진다. "그래... 넌 내 거지." <<He>>【은는】 만족스럽게 <<laughs>>. "주제를 알아서 다행이네, 내 작은 여우."
					<</if>>
				<<else>>
					<<if C.npc.Avery.rage gte 60 >>
						<<His>> 두 눈이 잠시 커졌다가, 욕망으로 어두워진다. "그래, 넌 내 차지지." <<He>>【은는】 거만하게 <<= either("코웃음 친다","콧방귀를 뀐다")>>. "그럼 내 것처럼 행동해!"
					<<elseif C.npc.Avery.rage gte 20>>
						<<His>> 두 눈이 잠시 커졌다가, 욕망으로 어두워진다. "그렇지, 안 그래?" <<He>>【은는】 만족스러운 듯 능글맞게 웃는다. "그럼 행동도 똑바로 하는 게 좋을 거야, <<girl>>."
					<<else>>
						<<His>> 두 눈이 잠시 커졌다가, 욕망으로 어두워진다. "그래... 넌 내 거지." <<He>>【은는】 만족스럽게 <<laughs>>. "그럼 행동도 똑바로 하는 게 좋을 거야, <<pcpetname "Avery">>."
					<</if>>
				<</if>>
			<<case "avery_moan_romance">> /* I love you, Avery */
				<<if C.npc.Avery.rage gte 60 >>
					<<He>>【은는】 비웃는다. "그래? 요새 하도 말을 안 들어서 깜빡 속을 뻔했네."
				<<elseif C.npc.Avery.rage gte 20>>
					<<He>>【은는】 능글맞게 웃는다. "알아. 그래도 원한다면 다시 말해봐."
				<<else>>
					<<He>>【은는】 <<= either("미소 짓는다","<<laughs>>")>>. "알아. 귀엽네."
				<</if>>
				<<npcincr Avery rage -1>><<larage>>
			<<case "avery_moan_daddy">> /* Put me in my place, daddy */
				<<if $consensual>>
					<<if C.npc.Avery.rage gte 60 >>
						"오, 네 주제를 확실히 알게 해주지. <<nnpc_Mummy "Avery">>가 널 제대로 혼내주려고 벼르고 있었거든."
					<<elseif C.npc.Avery.rage gte 20>>
						<<He>>【은는】 다 안다는 듯 미소 짓는다. "<<nnpc_mummy "Avery">>가 네 주제를 알려줬으면 좋겠어? 관심받으려고 일부러 떼를 썼나 보네."
					<<else>>
						<<He>>【은는】 가볍게 웃는다. "음. 네가 날 그렇게 부르는 게 참 좋아. 걱정 마, <<nnpc_mummy "Avery">>가 널 보살펴 줄 테니까."
					<</if>>
				<<else>>
					<<if C.npc.Avery.rage gte 60 >>
						<<He>>【은는】 코웃음 친다. "오, 그럴 생각이야. <<nnpc_mummy "Avery">>가 네가 어디에 속해 있는지 확실히 일깨워 줄 테니까."
					<<elseif C.npc.Avery.rage gte 20>>
						"<<nnpc_mummy "Avery">> 손길을 받으려고 반항한 거였어? 기꺼이 네 주제를 알려주지."
					<<else>>
						"<<nnpc_mummy "Avery">>가 네 주제를 알려줬으면 좋겠어? 내 손을 더럽히게 만들지 말고 그냥 예의 바르게 부탁하지 그랬니."
					<</if>>
				<</if>>
			<<case "avery_moan_premansion">> /* Take me away from that place */
				<<if C.npc.Avery.rage gte 60 >>
					"안타깝네. 네가 나랑 아무것도 엮이기 싫어했던 걸로 기억하는데."
				<<elseif C.npc.Avery.rage gte 20>>
					"다시 부탁하게 만들어야겠군. 넌 절박할 때 목소리가 훨씬 달콤하거든."
				<<else>>
					<<He>>【은는】 장난스럽게 미소 짓는다. "음. 네가 내 집에서 나를 기다리는 모습은 꽤 사랑스럽겠지."
				<</if>>
			<<case "avery_moan_mansion">> /* Let me show you how grateful I am */
				<<if C.npc.Avery.rage gte 60 >>
					"그 갑작스러운 감사하는 마음이 오래가길 바라지. 최근 네 행동은 전혀 받아들일 수 없었거든."
				<<elseif C.npc.Avery.rage gte 20>>
					"계속 그렇게만 하면 나도 불평할 일은 별로 없을 거야. 너도 그걸 원하잖아, 안 그래?"
				<<else>>
					<<He>>【은는】 능글맞게 웃는다. "완벽한 대답이야. 자, 이제 그 예쁜 제안을 한번 써먹어 볼까."
				<</if>>
		<</switch>>
	/* PC Demanding  */
	<<elseif $speechdemand is 1>>
		<<switch $speechspecialdialogue>>
			<<case "avery_demand_default">> /* You don't pay me enough */
				<<if C.npc.Avery.rage gte 20 or $enemyanger gt 20>>
					"감히 나한테 돈 얘기를 꺼내지 마, 이 탐욕스러운 꼬마 창녀야!"
				<<else>>
					<<His>> 두 눈이 가늘어진다. "그렇게 굴면서 더 내놓으라고 요구하다니 배짱 한 번 두둑하네."
				<</if>>
			<<case "avery_demand_mansion">> /* Stop it Avery */
				<<if C.npc.Avery.rage gte 20 or $enemyanger gt 20>>
					<<He>>【은는】 조롱하듯 웃는다. "동등한 파트너 행세를 하고 싶어? 그럼 복종하는 법부터 배워!"
				<<else>>
					"타이틀이 있다고 해서 네가 잘못했을 때 훈육을 피할 수 있는 건 아니야."
				<</if>>
			<<case "avery_demand_hunting">> /* Get the hell away */
				<<if C.npc.Avery.rage gte 20 or $enemyanger gt 20>>
					"너한테는 항상 끝이 없지!" <<he>>【이가】 내뱉는다. "넌 내가 해주는 건 하나도 고마워하지 않아! 항상 부족하기만 하지!"
				<<else>>
					"너한테는 항상 끝이 없지!" <<he>>【이가】 화를 내며 씩씩거린다. "넌 내가 해주는 건 하나도 고마워하지 않아!"
				<</if>>
			<<case "avery_demand_romance">> /* I told you I loved you */
				<<if C.npc.Avery.rage gte 20 or $enemyanger gt 20>>
					<<His>> 표정이 분노로 일그러진다. "내가 널 위해 모든 걸 해줬는데도, 여전히 나와 함께 있는 것보다 그 시궁창이 낫다고 생각하는 거야?"
				<<else>>
					<<His>> 표정이 굳어진다. "내가 그 비참한 삶에서 널 빼내 줬는데, 그걸 내 얼굴에 집어 던지시겠다?"
				<</if>>
			<<default>> /* Mock/Disparage or defautl demand */
				<<if C.npc.Avery.rage gte 20>>
					<<He>>【은는】 씩씩거린다. "그 좆같은 입 다물어!"
				<<else>>
					"진짜 후회할 말 내뱉기 전에 그만두는 게 좋을 텐데, <<pcpetname "Avery">>," 얼굴에 어두운 빛을 띠며 <<he>>【이가】 으르렁거린다.
				<</if>>
		<</switch>>
	/* PC forgiving (Angel TF only) */
	<<elseif $speechforgive is 1>>
		<<if $avery_fate is "saved">>
			당신은 <<his>> <<= $enemyanger gt 20 or $enemyhealth lt $enemyhealthmax ? "분노한" : "짜증 난">> 표정이 미세하게 씰룩이는 것을 알아챈다.
		<<else>>
			<<if C.npc.Avery.rage gte 20>>
				"네가? 날 용서한다고?" <<He>>【은는】 짧게 폭소한다. "우리 사이에 용서가 필요한 쪽이 있다면 그건 바로 너야!"
			<<else>>
				"대체 날 뭘 용서한다는 거야?" <<He>>【은는】 코웃음 친다. "넌 네가 자초한 일을 당하고 있을 뿐이야, 이 맹랑한 <<bastard>>."
			<</if>>
		<</if>> 
	/* PC apologizing more than once */
	<<elseif $speechapologiseno is 1>>
		<<if $enemyanger lte 20>>
			<<print either(
				`"보렴, 저렇게 간절하게 엎드려 비는 모습을," <<he>>【이가】 달콤하게 속삭인다. "조용히 해, 이미 널 용서했으니까."`,
				`"내 마음에 들려고 안달 난 모습을 보는 건 꽤 귀엽지만, 한 번으로 족해."`,
				`<<He>>【은는】 진심으로 즐거운 듯 웃음을 터뜨린다. "이미 네 사과를 받아들였어, <<pcpetname "Avery">>. 계속 굽실거릴 필요 없어."`
				)>>
		<<elseif $enemyanger lte 100>>
			<<print either(
				`"그렇게 빨리 엎드려 비는 태도로 나오니 제법 귀엽네." <<He>>【은는】 차갑게 미소 짓는다. "어느 정도는."`,
				`"네 절박함이 꽤 재미있긴 하네," <<he>>【이가】 건조하게 웃는다. "하지만 내 용서가 무한정 쏟아지는 건 아니란다."`,
				`"내 호의가 영원할 거라 착각하지 마, <<pcpetname "Avery">>," <<he>>【이가】 비웃는다.`
			)>>
		<<else>>
			<<print either(
				`"네가 거짓말하고 있다는 걸 진작에 알아챘어야 했는데!" <<He>>【은는】 몹시 분노한 듯 보인다.`,
				`"내가 거기에 또 속아 넘어갈 줄 알았다면 네 생각보다 내가 훨씬 어리석은 줄 알았나 보군!"`,
				`"내 심기를 거스를 때마다 사과 한마디로 넘어갈 수 있을 줄 알았나?" <<he>>【이가】 코웃음 친다. "네 속임수에 두 번은 안 속아."`,
				`"입 아프게 떠들지 마. 넌 다시 날 거스른 순간 네게 주어진 용서를 다 써버렸으니까."`,
				`"너 같은 거짓말쟁이의 사과를 또 받아줄 것 같아?" <<He>>【은는】 조롱하듯 웃는다. "꿈 깨."`
			)>>
		<</if>>
	<<elseif $speechapologise is 1 and $avery_fate is "saved">>
		<<if C.npc.Avery.rage lt 60>>
			"...드디어 내가 시키는 대로 할 생각이 든 거니?" <<He>>【은는】 억지로라도 평정을 되찾으려 애쓰는 듯 보인다.
		<<else>>
			"...드디어 교훈을 얻었다면 차라리 일찍 깨닫는 편이 나았겠지. 이제 한 번이라도 얌전히 굴어볼 테냐?" <<He>>【은는】 마지못해 평정을 되찾은 듯 보인다.
		<</if>>
		<<note "Avery's Saviour" "teal">>

	/* PC apologizing when Avery has the unforgiving trait  */
	<<elseif $speechapologiseunforgiving is 1 and $consensual>>
		<<if $enemyanger lte 20 or C.npc.Avery.rage lt 20>>
			<<print either(
				`"입 아프게 떠들 필요 없어, <<pcpetname "Avery">>," 미소를 지으며 <<he>>【이가】 말한다.`, 
				`"정말 미안했다면 애초에 그런 짓은 안 했겠지," 눈썹을 치켜올리며 <<he>>【이가】 말한다.`, 
				)>>
		<<elseif $enemyanger lte 100 or C.npc.Avery.rage lt 60>>
			<<print either(
				`"네가 한 짓에 딱 맞는 대가를 치르게 될 거야, <<girl>>."`,
				`"입 아프게 떠들지 마," 짓궂게 웃으며 <<he>>【이가】 말한다.`,
				)>>
		<<else>>
			<<print either(
				`"그 좆같은 입 다물어," <<he>>【이가】 씩씩거린다. "그쯤 했으면 됐어."`, 
				`"정말 미안했다면 애초에 그런 짓은 안 했겠지, 이 <<= either("<<bitch>>","<<bastard>>","<<cunt>>")>>야."`, 
				)>>
		<</if>>
	<<elseif $speechapologiseunforgiving is 1 and !$consensual>>
		<<if $enemyanger lte 20 or C.npc.Avery.rage lt 20>>
			<<print either(
				`"입 아프게 떠들지 마, <<pcpetname "Avery">>," 고통을 약속하는 듯한 억지 미소를 지으며 <<he>>【이가】 말한다.`, 
				`"정말 미안했다면 애초에 그런 짓은 안 했겠지," 무자비한 시선으로 쏘아보며 <<he>>【이가】 말한다.`, 
				`"오, 미안하다고? 그럼 증명해 봐," <<he>>【이가】 <<= either("씩씩거린다","으르렁거린다","성내며 말한다")>>. "반항하지 말고, <<girl>>."`
				)>>
		<<elseif $enemyanger lte 100 or C.npc.Avery.rage lt 60>>
			<<print either(
				`"네가 한 짓에 딱 맞는 대가를 치르게 될 거야, <<girl>>!"`,
				`"입 아프게 떠들지 마," 짓궂게 웃으며 <<he>>【이가】 말한다.`,
				`"그냥 얌전히 받아들여, 이 더러운 <<= either("slut","<<bitch>>","창녀","tramp","fucktoy")>>야!"`
				)>>
		<<else>>
			<<print either(
				`"그 좆같은 입 다물어!" <<he>>【이가】 씩씩거린다. "진짜 사과로 이 상황을 빠져나갈 수 있을 거라 생각했어?"`, 
