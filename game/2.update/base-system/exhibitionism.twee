:: Widgets Exhibitionism [widget]
<<widget "exhibitionism1">>
	<<exhibitionismN 1>>
<</widget>>

<<widget "exhibitionism2">>
	<<exhibitionismN 2>>
<</widget>>

<<widget "exhibitionism3">>
	<<exhibitionismN 3>>
<</widget>>

<<widget "exhibitionism4">>
	<<exhibitionismN 4>>
<</widget>>

<<widget "exhibitionism5">>
	<<exhibitionismN 5>>
<</widget>>

<<widget "exhibitionism6">>
	<<exhibitionismN 6>>
<</widget>>

<<widget "exhibitionismN">>
	<<set $_n to _args[0]>>
	<<set $_scaledExhibitionismMax to 20 * $_n>>
	<<if $desperateaction is 1>>
		역겨운 기분이 들지만, 베일리가 당신에게 저지를 일보다는 낫다.
	<<elseif $desperateaction is 2>>
		역겨운 기분이 들지만, 다른 대안보다는 낫다.
	<<elseif typeof $desperateaction is "string">>
		역겨운 기분이 든다. <<print $desperateaction>>.
	<<else>>
		<<if $control lt $controlmax>>
			<<if $_n is 6>>
				그런 광기 어린 타락 행위는 <span class="green">당신의 통제력을 완전히 회복시키지만</span>, <span class="red">정신에는 타격을 입힌다</span>.
			<<elseif $exhibitionism lt $_scaledExhibitionismMax>>
				그런 음란한 행위는 당신을 흥분시키고, 당분간 <span class="green">통제력과 자존감을 회복시켜 준다</span>.
			<<else>>
				그런 음란한 행위는 당신을 흥분시키지만, 머리 위를 짓누르는 먹구름을 걷어내지는 못한다. <span class="pink">뭔가 더 극단적인 행동을 해야 한다.</span>
			<</if>>
		<<else>>
			<<if $_n is 6>>
				당신은 이미 스스로를 통제하고 있다고 느낀다. <span class="red">이런 광기 어린 타락 행위도 헛수고처럼 느껴져 만족감을 얻지 못한다</span>.
			<<elseif $exhibitionism lt $_scaledExhibitionismMax>>
				당신은 이미 스스로를 통제하고 있다고 느끼지만, 그런 음란한 행위는 당신을 <span class="green">진정시키고</span> 흥분시킨다.
			<<else>>
				당신은 이미 스스로를 통제하고 있다고 느낀다. 그 행위는 <span class="pink">진정시키기에는 너무 시시하지만</span>, 그래도 흥분되기는 한다.
			<</if>>
		<</if>>
		<<if !hasSexStat("exhibitionism", $_n, false) and $drunk gte 1>>
			<<if $_n is 6>>
				<span @class="'red ' + basicDrunkCss()">머리가 몽롱하고 붕 뜨는 기분이다. 나중에 이 일을 기억하지 못하기를 바란다.</span>
			<<else>>
				<span @class="'blue ' + basicDrunkCss()">알코올이 수치심을 무디게 만들자 몸이 붕 뜬 것 같다.</span>
			<</if>>
		<</if>>
	<</if>>

	<!-- separating the code from the written text -->
	<<if $desperateaction is 1 or $desperateaction is 2 or typeof $desperateaction is "string">>
		<<control `$_n * -10`>>
		<<switch $_n>>
			<<case 1>><<lcontrol>>
			<<case 2>><<llcontrol>>
			<<case 3>><<llcontrol>>
			<<case 4>><<llcontrol>>
			<<case 5>><<lllcontrol>>
		<</switch>>
		<<gtrauma>><<trauma $_n>>
	<<else>>
		<<if $_n is 6>>
			<<set $exhibitionism += 2>>
			<<if $control lt $controlmax>>
				<<control $controlmax>>
				<<gggcontrol>>
			<</if>>
			<<trauma 40>>
			<<ggtrauma>>
		<<elseif $exhibitionism lt $_scaledExhibitionismMax>>
			<<set $exhibitionism += 2>>
			<<if $control lt $controlmax>>
				<<ggcontrol>>
			<</if>>
			<<control 25>>
			<<stress $_n -300>>
			<<combattrauma `$_n * -30`>>
			<<ltrauma>>
			<<lstress>>
		<<else>>
			<<if V.daily["exhibitionismStress" + $_n] isnot 1 and $statFreeze isnot true>>
				<<set V.daily["exhibitionismStress" + $_n] to 1>><<lstress>><<stress $_n -100>>
			<</if>>
		<</if>>
		<<arousal `$_n * 100`>><<garousal>>
	<</if>>
	<<set $exhibitionism to Math.clamp($exhibitionism, 0, 100)>>
	<<earSlimeSeenActions "exhibitionism" $_n>>
	<br><br>
	<<unset $desperateaction>>
<</widget>>

