/*ToDo: Pregnancy Story Content: Lacking events. For events that can be picked when random events can be used during player action, say entering the wolf cave*/
:: ChildrenEvents [widget]

/* The whole bathe-the-child scene: shared intro, one of four flavours
   (gentle/shampoo/calm/tantrum), shared wrap-up, and the right prop for each.
   Optional arg picks the flavour; leave it out for a random one. */
<<widget "childBatheScene">>
	<<set _flavour to _args[0]>>
	<<if !_flavour>>
		<<rng 5>>
		<<switch $rng>>
			<<case 1>><<set _flavour to "gentle">>
			<<case 2>><<set _flavour to "shampoo">>
			<<case 3>><<set _flavour to "calm">>
			<<default>><<set _flavour to "tantrum">>
		<</switch>>
	<</if>>
	<<if _flavour is "shampoo" or _flavour is "calm">>
		<<wearProp "soap">>
	<<else>>
		<<wearProp "rag" "white">>
	<</if>>
	당신은 작은 욕조에 따뜻한 물을 채우고 수건과 새 기저귀를 미리 준비해 둔다. 조심스럽게 <<childname>>【을를】 안아 들고 욕조로 데려가 안전한 자세로 눕힌다.
	<br><br>
	<<switch _flavour>>
		<<case "gentle">>
			그런 다음 한 손으로 <<childhis>> 작은 몸을 잡고, 피부 주름 사이사이를 꼼꼼히 닦으며 따뜻한 물로 <<childname>>【을를】 부드럽게 문질러 씻긴다. 문지를 때 느껴지는 <<childhis>> 부드러운 피부에 당신은 무척이나 편안해진다. 아기는 당신의 손길이 간지러운지 물장구를 치고, 그 물이 당신의 옷과 얼굴로 튄다. 당신은 이 상황에 절로 미소가 지어진다.<<ltrauma>><<trauma -6>>
		<<case "shampoo">>
			그런 다음 유아용 샴푸를 한 움큼 덜어내어 <<childname>>의 머리를 둥글게 원을 그리며 부드럽게 문지른다. 달콤한 딸기 향이 주변을 채우고 물 위에 거품이 일기 시작한다. 아이는 신기한 듯 틈틈이 <<childhis>> 손가락으로 거품을 콕콕 찔러 터뜨린다. <<childhe>>【이가】 욕조의 거품에 정신이 팔린 사이, <<childHis>> 부드러운 웃음소리가 방 안에 울려 퍼진다.<<ltrauma>><<lstress>><<trauma -6>><<stress -6>>
		<<case "calm">>
			그런 다음 아기의 몸에 비누칠을 시도하며 목욕을 시작한다. <<childHe>>【은는】 당신이 <<childhim>>【을를】 씻기려는 걸 즐기기는커녕, 피부에 물이 닿는 느낌조차 싫은 기색이다. 계속 씻기려 하자 <<childname>>【이가】 울음을 터뜨리려 하지만, 당신은 약간의 실랑이 끝에 간신히 <<childhim>>【을를】 진정시킨다. <<childHe>>【은는】 목욕이 끝날 때까지 불만스레 입을 삐죽인다. 목욕을 마친 후, <<childhe>>【은는】 당신이 <<childhim>>【을를】 안고 돌아가는 것도 싫은지, 당신이 들어 올릴 때마다 칭얼거리는 소리를 낸다.<<gstress>><<stress 6>>
		<<case "tantrum">>
			물에 닿자마자 <<childname>>【이가】 끊임없이 날카로운 울음을 터뜨린다. 당신이 제대로 씻겨보려 애쓰는 동안, <<childHe>>【은는】 어떻게든 빠져나가려고 물속에서 <<childhis>> 팔다리를 격렬하게 버둥거린다. 사방으로 튄 물에 당신의 옷이 순식간에 젖어버린다. <<childHe>>【은는】 목욕이 끝날 때까지 발버둥을 치며 떼를 썼고, 결국 당신에게 두통만을 안겨주었다.<<gstress>><<stress 6>>
		<<default>>
			<<run console.warn("childBatheScene: unexpected bath flavour: " + _flavour)>>
	<</switch>>
	<br><br>
	<<childhim>>의 목욕을 마친 후, 당신은 수건 위에 <<childhim>>【을를】 눕히고 더 부드러운 천으로 <<childhis>> 몸의 물기를 살살 닦아준다. 기저귀를 갈아입히고 <<childhim>>【을를】 다시 요람에 눕히며 조심스럽게 목욕 시간을 마무리한다.
	<</widget>>

/*args[0] - location, args[1] - passageExit*/
	<<widget "childrenEvents">>
	<<if _args[0]>>
		<<if _args[0] is "tower">>
			<<getChildrenIds `{location: _args[0], excludeUnhatched: true}` "both">>
		<<else>>
			<<getChildrenIds `{location: _args[0]}`>>
		<</if>>
		<<if _childrenIds.length gt 0>>
			<<set _singleEvents to true>>
		<</if>>
		<!-- Rework these later, they make no sense. Why can't children of different birth IDs interact? -->
		<<if _args[0] is "tower">>
			<<getSameBirthChildrenIds _args[0] 2 undefined "both">>
		<<else>>
			<<getSameBirthChildrenIds _args[0] 2>>
		<</if>>
		<<if Object.keys(_birthChildrenIds).length gt 0>>
			<<set _multipleEvents to true>>
		<</if>>
		<<set _keys to Object.keys(_birthChildrenIds)>>
		<<set $childPassageExit to _args[1]>>
		<<switch _args[0]>>
			<<case "home">>
				<<if _singleEvents is true and (_multipleEvents is false or random(0,100) gt 40)>>
					<<addevent `"homeSingles " + _childrenIds[random(0,_childrenIds.length - 1)]`>>
				<<elseif _multipleEvents is true>>
					<<set $childrenIds to _birthChildrenIds[_keys.random()]>>
					<<addevent `"homeMultiples " + _args`>>
				<</if>>
			<<case "wolf_cave">>
				<<if _singleEvents is true and (_multipleEvents is false or random(0,100) gt 40)>>
					<<addevent `"wolfCaveSingles " + _childrenIds[random(0,_childrenIds.length - 1)]`>>
				<<elseif _multipleEvents is true>>
					<<set $childrenIds to _birthChildrenIds[_keys.random()]>>
					/*<<addevent "wolfCaveMultiple _args">>*/
				<</if>>
			<<case "tower">>
				<<if _singleEvents is true and (_multipleEvents is false or random(0,100) gt 40)>>
					<<addevent `"hawkSingles " + _childrenIds[random(0,_childrenIds.length - 1)]`>>
				<<elseif _multipleEvents is true>>
					<<set $childrenIds to _birthChildrenIds[_keys[random(0,_keys.length - 1)]]>>
					<<addevent `"hawkMultiples " + _args`>>
				<</if>>
		<</switch>>
	<</if>>
<</widget>>

/* ============ 번역 필요 ============== */
<<widget "homeSingles">>
	<<if _args[0] isnot undefined>>
		<<childSelect _args[0]>>
		<<switch random(0,0)>>
			<<case 0>>
				You spot your child <<childname>> on <<childhis>> back, looking at you with <<childhis>> <<childhands>> stretched towards you.
				<br><br>
				Picking <<childhim>> up, <<childhe>> <<childgiggles>> while rubbing your face.
				<br><br>
				<<if $lactating is 1 and $settings.breastFeedingEnabled and $milk_amount gte 1>>
					<<link [[Breast feed (0:30)|childBreastFeed]]>><<pass 30>><</link>>
					<br>
				<</if>>
				<<link [[Cuddle (0:30)|childCuddle]]>><<pass 30>><</link>>
				<br>
				<<link [[Talk (0:15)|childTalk]]>><<pass 15>><</link>>
				<br>
				<<link [[Play (0:30)|childPlay]]>><<pass 30>><</link>>
				<br>
				<<link [[Bathe (0:30)|childBathe]]>><<pass 30>><</link>>
		<</switch>>
	<</if>>
	<br>
<</widget>>

<<widget "homeMultiples">>
	<<if $childrenIds>>
		<<switch random(0,0)>>
			<<case 0>>
				아이들인 <<childrenNames $childrenIds>>【이가】 요람 안에서 평온한 표정으로 함께 잠들어 있는 것을 발견한다.
				<br><br>
				<<link [[지켜보기 (0:30)|childCotWatch]]>><<stress -2>><<trauma -2>><<pass 30>><<set $phase to 1>><</link>><<lstress>><<ltrauma>>
				<br>
				<<link [[낮잠 자기 (0:30)|childCotWatch]]>><<stress -2>><<tiredness -2>><<pass 30>><<set $phase to 2>><</link>><<lstress>><<ltiredness>>
		<</switch>>
	<</if>>
<</widget>>

/* ============ 번역 필요 ============== */
<<widget "wolfCaveSingles">>
	<<if _args[0] isnot undefined>>
		<<childSelect _args[0]>>
		<<set _c to $childRecords[_args[0]]>>
		<<set _cPregnancy to getPregnancyOf(_c)>>
		<<set _hurtEligible to ["wolf","wolfboy","wolfgirl"].includes(_c.species) and (_cPregnancy.carrier is "Black Wolf" or _cPregnancy.donor is "Black Wolf")>>
		<<set _scene to 0>>
		<<if _hurtEligible>>
			<<set _scene to random(0,1)>>
		<</if>>
		<<switch _scene>>
			<<case 0>>
				You spot your <<childtype>> <<childname>> lying on a sleeping <<wolf_cave_singular>>, looking at you with <<childhis>> <<childhands>> stretched towards you.
				<br><br>
				Picking <<childhim>> up, <<childhe>> <<childgiggles>> while rubbing your face.
				<br><br>
				<<if $lactating is 1 and $settings.breastFeedingEnabled and $milk_amount gte 1>>
					<<link [[Breast feed (0:30)|childBreastFeed]]>><<pass 30>><</link>>
					<br>
				<</if>>
				<<link [[Cuddle (0:30)|childCuddle]]>><<pass 30>><</link>>
				<br>
				<<link [[Talk (0:15)|childTalk]]>><<pass 15>><</link>>
				<br>
				<<link [[Play (0:30)|childPlay]]>><<pass 30>><</link>>
			<<case 1>>
				<<childHe>>'s whining beside the Black Wolf, who growls at other wolves.
				<br><br>
				<<link [[Investigate (0:10)|Wolf Cave Hurt Pup]]>><<pass 10>><</link>>
		<</switch>>
	<</if>>
	<br>
<</widget>>

/* ============ 번역 필요 ============== */
<<widget "hawkSingles">>
	<<if _args[0] isnot undefined>>
		<<childSelect _args[0]>>
		<<switch random(0,2)>>
			<<case 0 1>>
				You spot your <<childtype>> <<childname>> lying in the nest, looking at you with <<childhis>> <<childhands>> stretched towards you.
				<br><br>
				Picking <<childhim>> up, <<childhe>> <<childgiggles>> and flails about.
				<br><br>

				<<if $cmonster is 1 and $lactating is 1 and $settings.breastFeedingEnabled and $milk_amount gte 1>>
					<<link [[Breast feed (0:30)|childBreastFeed]]>><<pass 30>><</link>>
					<br>
				<</if>>
				<<link [[Cuddle (0:30)|childCuddle]]>><<pass 30>><</link>>
				<br>
				<<link [[Talk (0:30)|childTalk]]>><<pass 30>><</link>>
				<br>
				<<link [[Play (0:30)|childPlay]]>><<pass 30>><</link>>
			<<case 2>>
				You see <<childname>> rolling around in the nest. As soon as <<childhe>> spots you, <<childhe>> rights <<childhimself>> and <<childgiggles>>. <<childHe>> seems happy to see you! <<stress -12>><<llstress>>
				<br><br>

				<<link [[Next|$childPassageExit]]>><<unset $childPassageExit>><<endevent>><</link>>
				<br>
		<</switch>>
	<</if>>
	<br>
<</widget>>

<<widget "hawkMultiples">>
	<<if $childrenIds>>
		<<switch random(0,0)>>
			<<case 0>>
				당신은 <<childrenNames $childrenIds>>【이가】 서로의 위를 구르며 뒤엉켜 있는 것을 발견한다.
				<<set _child1 to _childrenIds.pluck()>>
				<<set _child2 to _childrenIds.pluck()>>
				녀석들은 이따금 행동을 멈추고 서로를 빤히 쳐다본다. 잠시 후, <<childname _child1>>【이가】 <<childSelect _child2>><<childname>> 뒤로 다가가 <<childhim>>【을를】 핥아주기 시작한다.
				<br><br>

				<<link [[다음|$childPassageExit]]>><<unset $childrenIds>><<unset $childPassageExit>><<endevent>><</link>>
				<br>
		<</switch>>
	<</if>>
<</widget>>

:: Wolf Cave Hurt Pup
/* ============ 번역 필요 ============== */
<<set _hurtPupId to $childSelected.childId>>
<<effects>><<clearsinglenpc 0>><<npc "Black Wolf">>
<<childSelect _hurtPupId>>

You decide to investigate and find your <<childtype>> whimpering beside the Black Wolf, who looks aggressive and growls at any other wolf that tries to approach. <<bHe>> growls at you too, until <<bhe>> realises it's you, and calms slightly.
<br><br>

<<if $monster is 1>>

	"<<childHe>>'s hurt," <<bHe>> says, gesturing at your <<childtype>>. "Tripped." <<bHe>> insistently points to something on the cave floor. A jagged rock lies not too far away from your <<childtype>>.
	<br><br>

	You kneel down and examine your <<childtype>>. There's a scrape on one of <<childhis>> paws. It's nothing serious, but painful for a young one. The Black Wolf watches you two intently.
	<br><br>

	You clean the wound as best you can with what you have available, and your <<childtype>> stops whimpering. <<childHe>> nuzzles against you and licks your hand. <<ltrauma>><<lstress>><<trauma -6>><<stress -6>>
	<br><br>

	You three spend a bit of time together in silence until the Black Wolf retreats once again to the outside of the cave.

<<else>>

	The Black Wolf's face turns towards something on the cave floor, huffing insistently. <<bHe>> wants you to look. You find a jagged rock not too far away from where your <<childtype>> is.
	<br><br>

	You kneel down and examine your <<childtype>>. There's a scrape on one of <<childhis>> paws. Nothing serious, but painful for a young one. The Black Wolf circles around you both.
	<br><br>

	You clean the wound as best you can with what you have available, and your <<childtype>> stops whimpering. <<childHe>> nuzzles against you and licks your hand. <<ltrauma>><<lstress>><<trauma -6>><<stress -6>>
	<br><br>

	You three spend a bit of time together in silence until the Black Wolf retreats once again to the outside of the cave.

<</if>>
<br><br>

<<link [[Next|$childPassageExit]]>><<unset $childPassageExit>><<endevent>><</link>>

:: childBreastFeed
<<set $pregnancyStats.childBreastfedInteractions++>>
<<if $worn.over_upper.name isnot "naked" or $worn.upper.name isnot "naked" or $worn.upper.name isnot "naked">>
	당신은 <<childhim>>에게 <<breasts>>【을를】 물릴 수 있도록 옷을 바로잡는다.
<<else>>
	당신은 아기의 입술을 가슴에 가져다 댄다.
<</if>>
<br><br>
<<set _rng to random(1, 4)>>
<<switch _rng>>
	<<case 1>>
		<<childHe>>【은는】 당신의 의도를 알아차린 듯 눈을 감은 채 당신의 <<print ["왼쪽","오른쪽"].pluck()>> 가슴을 빤다.<<breastfeed 25>>
	<<case 2>>
		<<childHe>>【은는】 당신의 젖꼭지를 찾는 데 잠시 시간이 걸린다. <<childHe>>【은는】 젖꼭지를 물고 빨기 시작한다. 당신은 아기가 젖을 마시는 것을 보며 평온한 순간을 즐긴다.<<lstress>><<stress -6>><<breastfeed 20>>
	<<case 3>>
		<<childHe>>【은는】 당신의 젖꼭지를 물고 놀라울 정도로 열심히 빨기 시작한다. <<childhis>> 빠는 힘에 당신은 곧 불편함을 느낀다. 젖꼭지가 곧 쓰라려온다.<<gpain>><<pain 4>><<breastfeed 30>>
	<<default>>
		<<childHe>>【은는】 당신의 젖꼭지를 <<childhis>> 입에 무는 것을 거부하며, <<childhis>> 머리를 돌리고 이전보다 더 크게 운다.<<gstress>><<stress 6>>
<</switch>>
<br><br>

<<link [[다음|$childPassageExit]]>><<unset $childPassageExit>><<endevent>><</link>>

:: childCuddle
/* ============ 번역 필요 ============== */
<<set _rng to random(1, 5)>>
<<switch $childRecords[$childSelected.childId].species>>
	<<case "human">>
		<<switch _rng>>
			<<case 1>>
				<<childHe>> seems to realise your intent and wraps <<childhis>> <<childhands>> around your neck while leaning on your shoulder.
			<<case 2>>
				You hum a melodic lullaby, rubbing <<childname>>'s back as you gently sway to the tune. The familiarity of your voice seems to soothe <<childhis>> mood. <<childHe>> coos at you.<<ltrauma>><<lstress>><<trauma -6>><<stress -6>>
			<<case 3>>
				You place a soft kiss on <<childhis>> forehead and give <<childhim>> as much skin-to-skin contact as you can. The action encourages <<childhim>> to lift <<childhis>> head and reward you with a smile.<<ltrauma>><<lstress>><<trauma -6>><<stress -6>>
			<<case 4>>
				You give <<childname>> a few different objects to look at. You explain the colours, shapes, and textures of things that you see around you. <<childHe>> reaches out to touch, curious to explore <<childhis>> environment. You make sure <<childhe>> doesn't try to grasp anything too heavy or awkward.<<gstress>><<stress 6>>
			<<default>>
				<<childHe>> revolts against being carried, and <<childhe>> kicks <<childhis>> legs. The longer you hold <<childhim>>, the more intense <<childhis>> cries become. Some of <<childhis>> kicks connect.<<gpain>><<gstress>><<pain 4>><<stress 6>>
		<</switch>>
	<<case "wolf" "wolfboy" "wolfgirl">>
		<<switch _rng>>
			<<case 1>>
				<<if $cmonster is 1>>
					<<childHe>> seems to realise your intent and wraps <<childhis>> <<childhands>> around your neck while leaning on your shoulder.
				<<else>>
					<<childHe>> seems to realise your intent and settles into the crook of your neck.
				<</if>>
			<<case 2>>
				You hum a melodic lullaby, rubbing <<childname>>'s back as you gently sway to the tune. The familiarity of your voice seems to soothe <<childhis>> mood. <<childHe>> coos at you.<<ltrauma>><<lstress>><<trauma -6>><<stress -6>>
			<<case 3>>
				<<if $cmonster is 1>>
					You place a soft kiss on <<childhis>> forehead and give <<childhim>> as much skin-to-skin contact as you can. The action encourages <<childhim>> to lift <<childhis>> head and reward you with a smile.<<ltrauma>><<lstress>><<trauma -6>><<stress -6>>
				<<else>>
					You place a soft kiss on <<childhis>> forehead and give <<childhim>> as much skin-to-fur contact as you can. The action encourages <<childhim>> to lift <<childhis>> head and stick <<childhis>> tongue out at you.<<ltrauma>><<lstress>><<trauma -6>><<stress -6>>
				<</if>>
			<<case 4>>
				You give <<childname>> a few different objects to look at. You explain the colours, shapes, and textures of things that you see around you. <<childHe>> picks a stick up in <<childhis>> mouth and starts to shake it around. You make sure <<childhe>> doesn't try to grasp anything else too heavy or awkward.<<gstress>><<stress 6>>
			<<default>>
				<<childHe>> revolts against being carried, and <<childhe>> kicks <<childhis>> legs. The longer you hold <<childhim>>, the more intense <<childhis>> cries become. Some of <<childhis>> kicks connect.<<gpain>><<gstress>><<pain 4>><<stress 6>>
		<</switch>>
	<<case "hawk">>
		<<switch _rng>>
			<<case 1>>
				<<if $cmonster is 1>>
					<<childHe>> seems to realise your intent and wraps <<childhis>> <<childhands>> around your neck while leaning on your shoulder.
				<<else>>
					<<childHe>> seems to realise your intent and settles into the crook of your neck.
				<</if>>
			<<case 2>>
				You hum a melodic lullaby, rubbing <<childname>>'s back as you gently sway to the tune. The familiarity of your voice seems to soothe <<childhis>> mood. <<childHe>> coos at you.<<ltrauma>><<lstress>><<trauma -6>><<stress -6>>
			<<case 3>>
				<<if $cmonster is 1>>
					You place a soft kiss on <<childhis>> forehead and give <<childhim>> as much skin-to-skin contact as you can. The action encourages <<childhim>> to lift <<childhis>> head and reward you with a smile.<<ltrauma>><<lstress>><<trauma -6>><<stress -6>>
				<<else>>
					You place a soft kiss on <<childhis>> forehead and give <<childhim>> as much skin-to-feather contact as you can. The action encourages <<childhim>> to lift <<childhis>> head and chirp at you.<<ltrauma>><<lstress>><<trauma -6>><<stress -6>>
				<</if>>
			<<case 4>>
				You give <<childname>> a few different materials to look at. You explain the colours, shapes, and textures of things that you see around you.
				<<if $cmonster is 1>>
					<<childHe>> reaches out to touch, curious to explore <<childhis>> environment. <<childHe>> grabs onto a piece of cloth
				<<else>>
					<<childHe>> reaches out to peck at a piece of cloth that you're showing <<childhim>>. <<childHe>> manages to get it away from you,
				<</if>>
				and starts to shake it about. <<childHe>> <<childgiggles>>, but you make sure <<childhe>> doesn't try to grab anything else. <<gstress>><<stress 6>>
			<<default>>
				<<if $cmonster is 1>>
					<<childHe>> revolts against being carried, and <<childhe>> kicks <<childhis>> legs. The longer you hold <<childhim>>, the more intense <<childhis>> cries become. Some of <<childhis>> kicks connect.<<gpain>><<gstress>><<pain 4>><<stress 6>>
				<<else>>
					<<childHe>> revolts against being carried and manages to slip your grasp. <<childHe>> falls harmlessly into the nest, but the act gives you quite the start. <<ggstress>><<stress 12>>
				<</if>>
		<</switch>>
	<<default>>
		<span class="red">Childtype $childRecords[$childSelected.childId].species not found. This is a bug.</span>
<</switch>>
<br><br>

<<link [[Next|$childPassageExit]]>><<unset $childPassageExit>><<endevent>><</link>>

:: childCotWatch
<<childSelect `$childrenIds[random(0,$childrenIds.length - 1)]`>>
<<if $phase is 1>>
	당신은 <<childrenNames $childrenIds>> 곁에 서서 잠든 모습을 지켜본다.
	<<set _rng to random(1, 4)>>
	<<switch _rng>>
		<<case 1>>
			얌전한 숨소리에 맞춰 오르내리는 <<childname>>의 가슴에서 눈을 뗄 수 없다.
		<<case 2>>
			어느새 아이들의 머리를 하나씩 쓰다듬고 있다.
		<<case 3>>
			<<childname>>【은는】 <<childhis>> 입을 크게 벌려 하품을 하고 기지개를 켠다.<<lstress>><<stress -6>>
		<<default>>
			<<childname>>【은는】 나쁜 꿈이라도 꾸는 듯, 웅얼거리며 <<childhis>> 얼굴을 찡그린다.<<gstress>><<stress 6>>
	<</switch>>
	<br><br>
<<elseif $phase is 2>>
	당신은 낮잠을 자기로 하고 아이들 옆 침대에 눕는다.
	<br><br>
	얼마 후 잠에서 깨자 손가락에 무언가 감겨 있다. 아직 잠든 채로, <<childname>>의 <<childhand>>【이가】 당신에게 닿은 모양이다.
	<br><br>
<</if>>

<<link [[다음|$childPassageExit]]>><<unset $childrenIds>><<unset $childPassageExit>><<endevent>><</link>>

:: childTalk
/* ============ 번역 필요 ============== */
<<set _rng to random(1, 4)>>
<<switch $childRecords[$childSelected.childId].species>>
	<<case "human">>
		<<switch _rng>>
			<<case 1>>
				You recite a few nursery rhymes you remember from long ago. <<childHe>> looks alert as <<childhe>> listens to your voice. You make a few different tones and wait for <<childhis>> reaction. It seems to you like <<childhe>> recognises certain sounds and changes <<childhis>> expression accordingly. After a few more moments, <<childhe>> breaks eye contact and sucks on <<childhis>> thumb.
			<<case 2>>
				You gently cup <<childname>>'s right foot and count <<childhis>> toes, wriggling them before moving on to <<childhis>> next foot. <<childHe>> quiets, watching you with wide eyes as you move your finger from one toe to the next.
			<<case 3>>
				You chat to <<childname>>, sharing your thoughts and waiting for a response. <<childHe>> doesn't seem to be paying much attention however.<<gstress>><<stress 6>>
			<<default>>
				You speak to <<childname>>, but <<childhis>> cries drown your words. <<childHis>> face turns a deeper shade of red with every minute you spend trying to talk to <<childhim>>.<<gstress>><<stress 6>>
		<</switch>>
	<<case "wolf" "wolfboy" "wolfgirl">>
		<<switch _rng>>
			<<case 1>>
				You recite a few nursery rhymes you remember from long ago. <<childHe>> looks alert as <<childhe>> listens to your voice. You make a few different tones and wait for <<childhis>> reaction. It seems to you like <<childhe>> recognises certain sounds and changes <<childhis>> expression accordingly. After a few more moments, <<childhe>> tilts <<childhis>> head at you.
			<<case 2>>
				You gently cup <<childname>>'s
				<<if $cmonster is 1>>
					right foot and count <<childhis>> toes, wriggling them before moving on to <<childhis>> next foot. <<childHe>> quiets, watching you with wide eyes as you move your finger from one toe to the next.
				<<else>>
					front right paw and count <<childhis>> toes, wriggling them before moving on to <<childhis>> next paw. <<childHe>> quiets, watching you with wide eyes as you move your finger from one toe to the next.
				<</if>>
			<<case 3>>
				You chat to <<childname>>, sharing your thoughts and waiting for a response. <<childHe>> doesn't seem to be paying much attention however.<<gstress>><<stress 6>>
			<<default>>
				You speak to <<childname>>, but <<childhe>> softly barks at you every time you open your mouth. <<childHe>> headbutts your leg, then turns away.
		<</switch>>
	<<case "hawk">>
		<<switch _rng>>
			<<case 1>>
				You recite a few nursery rhymes you remember from long ago. <<childHe>> looks alert as <<childhe>> listens to your voice. You make a few different tones and wait for <<childhis>> reaction. It seems to you like <<childhe>> recognises certain sounds. After a few more moments, <<childhe>> tilts <<childhis>> head at you.
			<<case 2>>
				You gently cup <<childname>>'s
				<<if $cmonster is 1>>
					right foot and count <<childhis>> toes, wriggling them before moving on to <<childhis>> next foot. <<childHe>> quiets, watching you with wide eyes as you move your finger from one toe to the next.
				<<else>>
					right leg and count <<childhis>> talons, wriggling them before moving on to <<childhis>> next leg. <<childHe>> quiets, watching you as you move your finger from one talon to the next.
				<</if>>
			<<case 3>>
				You chat to <<childname>>, sharing your thoughts and waiting for a response. <<childHe>> doesn't seem to be paying much attention however.<<gstress>><<stress 6>>
			<<default>>
				You speak to <<childname>>, but <<childhe>> softly chirps at you every time you open your mouth. <<childHe>> headbutts your leg, then turns away.
		<</switch>>
	<<default>>
		<span class="red">Childtype $childRecords[$childSelected.childId].species not found. This is a bug.</span>
<</switch>>
<br><br>

<<link [[Next|$childPassageExit]]>><<unset $childPassageExit>><<endevent>><</link>>

:: childPlay
<<set _rng to random(1, 6)>>
<<switch _rng>>
	<<case 1>>
		당신은 <<childname>>【을를】 내려다보며 미소 짓는다. 손을 흔들고 혀를 내밀며, <<childhis>> 관심을 끌기 위해 여러 가지 표정을 지어 보인다. <<childHe>>【은는】 호기심을 갖고 당신의 표정을 살핀다. <<childHe>>【은는】 당신을 따라 하려는 것 같지만, 그저 반사적인 행동인지 확신할 수 없다.
	<<case 2>>
		당신은 <<childname>>의 <<childfeet>>【을를】 <<childhis>> <<childhands>>에 가져다 대고 움직여주며, 가끔씩 박수를 치게 한다. 당신은 <<childhis>> 발가락부터 등, 손가락 끝까지 작은 몸을 부드럽게 마사지해준다. 애정 어린 손길에 당신이 활짝 웃자, <<childHe>>【은는】 미소로 화답한다.
	<<case 3>>
		양손으로 얼굴을 가렸다가, 몇 초 뒤에 손을 뗀다. <<childname>>【이가】 당신을 올려다본다. 눈이 마주치자 <<childHe>>【이가】 미소 짓는다.<<lstress>><<stress -6>>
	<<case 4>>
		당신은 <<childname>>【을를】 간지럽히고 <<childhis>> 배에 입을 대고 부르르 소리를 낸다. 그러자 <<childHe>>【은는】 울음을 멈추고 대신 <<childgiggles>>하며, 기쁨에 겨워 <<childhis>> 팔다리를 버둥거린다.<<lstress>><<stress -6>>
	<<case 5>>
		당신은 <<childname>>【을를】 간지럽히고 <<childhis>> 배에 입을 대고 부르르 소리를 낸다. <<childhe>>【이가】 고개를 좌우로 돌리며 몸부림치자 <<childHis>> 울음소리가 더 커진다. <<childHe>>【은는】 이런 장난이 마음에 들지 않는 것 같다.<<gstress>><<stress 6>>
	<<default>>
		당신은 <<childhe>>【이가】 당신의 얼굴과 이목구비를 살필 수 있도록 <<childname>>에게 더 가까이 다가간다. <<childHe>>【은는】 잠시 울음을 멈추는가 싶더니, 당신의 머리카락을 잡아당긴다.<<gpain>><<pain 4>>
<</switch>>
<br><br>

<<link [[다음|$childPassageExit]]>><<unset $childPassageExit>><<endevent>><</link>>

:: childBathe
<<childBatheScene>>
<br><br>

<<childhim>>【을를】 다 씻기고 나면, <<childhim>>【을를】 수건 위에 눕히고 더 부드러운 천으로 <<childhis>> 몸을 부드럽게 말려준다. 당신은 아기의 기저귀를 갈아주고 <<childhim>>【을를】 다시 <<childhis>> 침대에 눕혀주며 조심스럽게 마무리한다.
<br><br>

<<link [[다음|$childPassageExit]]>><<unset $childPassageExit>><<endevent>><</link>>

:: Childrens Home
/* ============ 번역 필요 ============== */
<<effects>>
<<getChildrenIds `{location: $location}`>>
<<switch $location>>
	<<case "home">>
		You are in the orphanage nursery. There are a few cradles and cots scattered around.
	<<case "wolf_cave">>
		<<switch Time.dayState>>
			<<case "dawn">>
				Many of the pups are still asleep.
			<<case "day">>
				The yips, growls, and tiny howls of young pups playing echo off the rocky walls.
			<<case "dusk">>
				Most of the pups have already settled down for the night.
			<<case "night">>
				The pups are all asleep, and the den is silent.
		<</switch>>
	<<case "alex_cottage">>
		You are in the cottage nursery.
		<<switch Time.dayState>>
			<<case "dawn">>
				The sound of birds singing early in the morning soothes the room.
			<<case "day">>
				Sounds from the farm can be heard through the cottage.
			<<case "dusk">>
				A calm breeze flows through the curtain.
			<<case "night">>
				Silence fills the room.
		<</switch>>
	<<case "tower">>
		<<getChildrenIds `{location: $location, excludeUnhatched: true}` "both">>
		You are in the tower. You look around for your <<pluralise _childrenIds.length "child">>.
<</switch>>
<<if Time.dayState isnot "night" and (!$daily.childrenHomeEvent or !$daily.childrenHomeEvent.includes($location)) and random(1) is 1>>
	<<if !$daily.childrenHomeEvent>>
		<<set $daily.childrenHomeEvent to [$location]>>
	<<else>>
		<<run $daily.childrenHomeEvent.push($location)>>
	<</if>>
	<<cleareventpool>>
	<<childrenEvents $location $passage>>
	<<if _eventpool.length>>
		<<runeventpool>>
		<<exit>>
	<</if>>
<</if>>
<br><br>
<<childViewerDisplay _childrenIds>>
<br>
<<if $location isnot "tower">>
	<<if $location is "wolf_cave">>
		<<childicon "rope">>
	<<else>>
		<<childicon "teddy bear">>
	<</if>>
	<<if $player.inventory.childrenToys>>
		<<if !$storedChildrenToys[$location]>><<set $storedChildrenToys[$location] to []>><</if>>
		<<link [[Store children's toys|Childrens Home Toys]]>><</link>>
		<br>
	<<else>>
		You have not bought any toys for your children here. You should take a trip to <<= $location is "wolf_cave" ? "the pet store" : "the toy shop">>.
		<br>
	<</if>>
<</if>>
<<if $location is "home">>
	<<foodstufficon "baby_bottle_of_breast_milk">>
	<<if V.foodstuff['baby_bottle_of_breast_milk'] and V.foodstuff['baby_bottle_of_breast_milk'].amount gt 0>>
		<<link [[Donate breast milk|Childrens Donate Milk]]>><</link>>
		<<if $pregnancyStats.orphanageMilkBottles gt 0>>
			(<span class="green"><<print $pregnancyStats.orphanageMilkBottles>></span> bottles remaining)
		<<else>>
			(<span class="red"><<print $pregnancyStats.orphanageMilkBottles>></span> bottles remaining)
		<</if>>
	<<else>>
		You have no bottled breast milk to donate.
		<<if $pregnancyStats.orphanageMilkBottles gt 0>>
			(<span class="green"><<print $pregnancyStats.orphanageMilkBottles>></span> bottles remaining)
		<<else>>
			(<span class="red"><<print $pregnancyStats.orphanageMilkBottles>></span> bottles remaining)
		<</if>>
	<</if>>
	<br>
<</if>>
<<getouticon>><<link [[Back|$exitPassage]]>><<unset $exitPassage>><</link>>

:: Childrens Donate Milk
<<effects>>

<label>기부할 우유병 개수: <<numberslider "$donatedMilk" 1 1 `$foodstuff["baby_bottle_of_breast_milk"].amount` 1>></label>

<<link [[기부하기|Childrens Donate Milk 2]]>><</link>>
<br>
<<link [[뒤로|Childrens Home]]>><<unset $childActivityEvent>><<endevent>><</link>>

:: Childrens Donate Milk 2
<<effects>><<wearProp "baby bottle of breast milk">>

<<set $pregnancyStats.orphanageMilkBottles += $donatedMilk>>
<<set $pregnancyStats.orphanageMilkBottlesTotal += $donatedMilk>>
<<set $foodstuff["baby_bottle_of_breast_milk"].amount -= $donatedMilk>>

베일리의 부하 중 한 명에게 아이들을 위한 모유 젖병 $donatedMilk개를 맡기고 떠난다.
<br><br>

<<link [[뒤로|Childrens Home]]>><<unset $donatedMilk>><<unset $childActivityEvent>><<endevent>><</link>>

:: Childrens Home Toys
<<effects>>

<<set _selectedCurrentToy to 0>>
<<set _selectedLocationToy to 0>>

<div id="childrenToysUI">
	<<childrenToysUI>>
</div>

<br>
<<getouticon>><<link [[뒤로|Childrens Home]]>><<unset $childActivityEvent>><<endevent>><</link>>

:: Childrens Home Toys Widgets [widget]

<<widget "childrenToysUI">>
	<<toySelection>>
	<div class="settingsGrid">
		<div>
			<div class="itemInventoryHeader settingsHeader">인벤토리</div>
			<div class="itemInventory itemDetails">
				<<for _i to 0; _i lt 10; _i++>>
					<<set _toy to $player.inventory.childrenToys[_i]>>
					<<if _toy and _i lt 5>>
						<<set _name to window.KR.getToyNameKr(_toySelection, _toy.name)>>
						<<set _icon to _toy.name.toLowerCase().replace(".","")>>
						<<set _index to _i - 1>>
						<div @class="_selectedCurrentToy is _i ? 'item selected' : 'item'" @tooltip="_name" onclick="$(this).siblings().removeClass('selected'); $(this).addClass('selected')">
							<label>
								<<if $options.images is 1>>
									<<childicon _icon>>
								<<else>>
									<span @class="_toy.colour"><<print window.KR.getToyNameKr(_toySelection, _toy.name)>></span>
								<</if>>
								<<radiobutton "_selectedCurrentToy" _i autocheck>>
							</label>
						</div>
					<<else>>
						<<if _i lt 5>>
							<div class="item unknown"><<ind>></div>
						<<else>>
							<div class="item empty"><<ind>></div>
						<</if>>
					<</if>>
				<</for>>
			</div>
			<div class="containerFooter">
				<<if $player.inventory.childrenToys.length gt 0>>
					<div class="tab inventory">
						<<button "<span class='fa-icon fa-trash'></span> 버리기">>
							<<run $player.inventory.childrenToys.deleteAt(_selectedCurrentToy)>>
							<<set _selectedCurrentToy to 0>>
							<<childrenToysUIReplace>>
						<</button>>
					</div>
					<br>
					<<if $storedChildrenToys[$location].length lt 10>>
						<div class="tab inventory">
							<<button "<span class='fa-icon fa-import'></span> 보관">>
								<<run $storedChildrenToys[$location].push($player.inventory.childrenToys[_selectedCurrentToy])>>
								<<run $player.inventory.childrenToys.deleteAt(_selectedCurrentToy)>>
								<<set _selectedCurrentToy to 0>>
								<<childrenToysUIReplace>>
							<</button>>
						</div>
					<</if>>
				<<else>>
					<div class="tab inventory">
						<button class="link-internal macro-button buttonDisabled" disabled><<="<span class='fa-icon fa-trash'></span> 버리기">></button>
					</div>
					<div class="tab inventory">
						<button class="link-internal macro-button buttonDisabled" disabled><<="<span class='fa-icon fa-import'></span> 보관">></button>
					</div>
				<</if>>
			</div>
		</div>
		<div>
			<div class="itemInventoryHeader settingsHeader">
				<<switch $location>>
					<<case "wolf_cave">>늑대 동굴
					<<case "tower">>매의 탑
					<<default>>보육원
				<</switch>>
			</div>
			<div class="itemInventory itemDetails">
				<<for _i to 0; _i lt 10; _i++>>
					<<set _toy to $storedChildrenToys[$location][_i]>>
					<<if _toy>>
						<<set _name to window.KR.getToyNameKr(_toySelection, _toy.name)>>
						<<set _icon to _toy.name.toLowerCase().replace(".","")>>
						<div @class="_selectedLocationToy is _i ? 'item selected' : 'item'" @tooltip="_name" onclick="$(this).siblings().removeClass('selected'); $(this).addClass('selected')">
							<label>
								<<if $options.images is 1>>
									<<childicon _icon>>
								<<else>>
									<span @class="_toy.colour"><<print window.KR.getToyNameKr(_toySelection, _toy.name)>></span>
								<</if>>
								<<radiobutton "_selectedLocationToy" _i autocheck>>
							</label>
						</div>
					<<else>>
						<div class="item unknown"><<ind>></div>
					<</if>>
				<</for>>
			</div>
			<div class="containerFooter">
					<<if $storedChildrenToys[$location].length gt 0>>
						<div class="tab inventory">
							<<button "<span class='fa-icon fa-trash'></span> 버리기">>
								<<run $storedChildrenToys[$location].deleteAt(_selectedLocationToy)>>
								<<set _selectedLocationToy to 0>>
								<<childrenToysUIReplace>>
							<</button>>
						</div>
						<<if $player.inventory.childrenToys.length lt 5>>
							<div class="tab inventory">
								<<button "<span class='fa-icon fa-export'></span> 소지">>
									<<run $player.inventory.childrenToys.push($storedChildrenToys[$location][_selectedLocationToy])>>
									<<run $storedChildrenToys[$location].deleteAt(_selectedLocationToy)>>
									<<set _selectedLocationToy to 0>>
									<<childrenToysUIReplace>>
								<</button>>
							</div>
						<<else>>
							<div class="tab inventory">
								<button class="link-internal macro-button no-numberify buttonDisabled" disabled><span class='fa-icon fa-export'></span> 소지</button>
							</div>
						<</if>>
					<<else>>
						<div class="tab inventory">
							<button class="link-internal macro-button buttonDisabled" disabled><<="<span class='fa-icon fa-trash'></span> 버리기">></button>
						</div>
						<div class="tab inventory">
							<button class="link-internal macro-button buttonDisabled" disabled><<="<span class='fa-icon fa-export'></span> 소지">></button>
						</div>
					<</if>>
			</div>
		</div>
	</div>
<</widget>>

<<widget "childrenToysUIReplace">>
	<<replace "#childrenToysUI">>
		<<childrenToysUI>>
	<</replace>>
<</widget>>

:: Children Activity Events
/* ============ 번역 필요 ============== */
<<effects>>
<<childSelect $childActivityEvent.childid>>
<<childAge $childActivityEvent.childid>>
<<childInteratedWith>>
<<set $childRecords[$childActivityEvent.childid].development.event to false>>
<<switch $childActivityEvent.event>>
	/*Human Specific*/
	<<case "transfixed">>
		You stand over <<childname>> and watch <<childhim>> sleep. You're transfixed by <<childhis>> chest, rising and fallen with gentle breaths.
	<<case "stroke">>
		You stand over <<childname>> and watch <<childhim>> sleep. You find yourself stroking <<childhis>> head.
	<<case "yawn">>
		You stand over <<childname>> and watch <<childhim>> sleep. <<childHe>> opens <<childhis>> mouth in a big yawn and stretches.<<lstress>><<stress -6>>
	<<case "murmur">>
		You stand over <<childname>> and watch <<childhim>> sleep. <<childHe>> murmurs and scrunches <<childhis>> features, as if having a bad dream.<<gstress>><<stress 6>>
	<<case "cotNap">>
		You decide to have a nap and lie in the bed beside <<childname>>.
		<br><br>
		You wake up sometime later with something wrapped around your finger. While still asleep, it seems that <<childname>>'s <<childhand>> was able to reach you.<<ltiredness>><<tiredness -3>>
	<<case "shiverInCot">>
		<<childname>> sleeps by <<childherself>>, shivering with every unconscious breath. You tuck <<childhim>> in with a nearby baby blanket. <<childHe>>'s soon sleeping peacefully.<<lstress>><<stress -6>>
	<<case "restlessSleep">>
		<<childname>> is restless in <<childhis>> sleep. You lie down beside <<childhim>> and pull <<childhim>> against your chest. You hold <<childhim>> until <<childhe>> calms down. As you move to stand, <<childhe>> grasps your finger tight in <<childhis>> small hands. You snuggle for a while longer, before easing <<childhis>> hold on you and getting back to your feet.<<ltiredness>><<tiredness -6>><<llstress>><<stress -10>>
		<<set $childRecords[$childActivityEvent.childid].development.activity to "sleeping">>
	<<case "waveTongue">>
		You smile down at <<childname>>. You wave your hands and stick your tongue out, making several different faces in an attempt to catch <<childhis>> attention. <<childHe>> studies your expressions with curiosity. <<childHe>> is trying to imitate you, but you're unsure if it's just a reflex.
	<<case "handsClap">>
		You bring <<childname>>'s feet to <<childhis>> hands, moving them around and occasionally clapping them together. You give <<childhis>> body a gentle massage, from <<childhis>> toes, to <<childhis>> back, then all the way to <<childhis>> fingertips. You shower <<childhis>> frame in affectionate touches. <<childHe>> smiles in response to your broad grin.
	<<case "peekaboo">>
		You cover your face with both hands, then uncover it a few seconds later. <<childname>> peers up at you. <<childHe>> smiles when your eyes meet.<<lstress>><<stress -6>>
	<<case "blowRaspberriesHappy">>
		You tickle <<childname>> and blow raspberries on <<childhis>> stomach. <<childHe>> responds by interrupting <<childhis>> cries and laughs instead, flapping <<childhis>> arms and legs in joy.<<lstress>><<stress -6>>
	<<case "blowRaspberriesUpset">>
		You tickle <<childname>> and blow raspberries on <<childhis>> stomach. <<childHis>> cries become louder as <<childhe>> turns <<childhis>> head from side to side and squirms away. <<childHe>> seems upset over the treatment.<<gstress>><<stress 6>>
	<<case "faceStudy">>
		You get closer to <<childname>>, so <<childhe>> can study your face and its features. <<childHe>> stops crying for a moment, only to grab your hair and pull it.<<gpain>><<pain 4>>
	<<case "rockToSleep">>
		You scoop the <<childtype>> up in your arms and walk while gently rocking <<childhim>> side to side and humming softly. Soon <<childhe>> calms down and falls fast asleep in your arms. You gingerly lay <<childhim>> down in the cot to rest. <<lstress>><<stress -5>>
		<<set $childRecords[$childActivityEvent.childid].development.activity to "sleeping">>
	<<case "holdToShoulder">>
		You lift the <<childtype>>. <<childHe>> seems to realise your intent and wraps <<childhis>> <<childhands>> around your neck while leaning on your shoulder. You bob <<childhim>> up to down, until <<childhe>> falls asleep in your arms.<<lstress>><<stress -5>>
		<<set $childRecords[$childActivityEvent.childid].development.activity to "sleeping">>
	<<case "melodicLullaby">>
