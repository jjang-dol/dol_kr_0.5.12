			<br>
		<<else>>
			<<birdicon "preen">><<link [[Help the Great Hawk preen (0:15)|Bird Tower Bathe Preen]]>><<npcincr "Great Hawk" love 1>><<bird_stockholm 1>><<bird_pass 15>><</link>><<glove>><<gbirdstockholm>><<deviant1>>
			<br>
		<</if>>
	<</if>>
<<else>>
