	<br>
<</if>>
<<link [[물러난다|Bird Rescue No Syndrome Tower Pull]]>><<npcincr "Great Hawk" love -3>><<npcincr "Great Hawk" dom -1>><<bird_stockholm -1>><</link>><<if $phase gte 2>><<llove>><<ldom>><</if>><<lbirdstockholm>>
