:: Widgets Passout Beach [widget]
<<widget "passoutbeach">>
	<<if isPregnancyEnding()>>
		<<if $location is "beach">>
			<<pregnancyPassout "beach">>
		<<else>>
			<<pregnancyPassout "sea">>
		<</if>>
	<<else>>
		<<link [[모든 것이 어둠에 잠긴다...|Passout Beach]]>><</link>>
	<</if>>
<</widget>>

