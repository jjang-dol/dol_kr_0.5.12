			<<else>>
				<<link [[대련한다 (1:00)|Temple Cloister Spar Whip]]>><<prof whip 3>><<set $temple_spar to 1>><<physique 6>><<tiredness 6>><<grace 1 priest>><<pass 60>><</link>><<gtiredness>><<gwhip>><<gphysique>><<ggrace priest>>
			<</if>>
		<</if>>
		<br>
	<</if>>
<</if>>
<<if $temple_weapon is "baton">>
	<<templeicon "whip">><<link [[무기를 채찍으로 바꾼다|Temple Training Whip]]>><<set $temple_weapon to "whip">><</link>>
	<br>
<<elseif $temple_weapon is "whip">>
