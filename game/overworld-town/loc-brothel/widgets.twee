:: Widgets Brothel [widget]
<<widget "brothelshowintro">>
	<<set $showExplanations to $showExplanations || []>>
	<<if $passage is "Briar's Office Show Ask">>
		"다시 설명해 줄까?" 브라이어가 <<his>> 와인 잔을 내려놓는다. "우리에겐 몇 가지 선택지가 있지." <<He>>【은는】 손가락 하나를 들어 올린다.
	<<elseif $showExplanations.length lte 0>>
		<<He>>【이가】 자리에서 일어나 자기 책상 뒤로 걸어간다. "우리에겐 몇 가지 선택지가 있어." <<He>>【은는】 손가락을 꼽으며 설명한다.
	<<else>>
		<<He>>【은는】 <<his>> 잔에 담긴 와인을 빙빙 돌린다. "어떻게 돌아가는지는 알잖아. 평소대로의 선택지들이지."
	<</if>>
	<br><br>

	<<if $passage is "Briar's Office Show Ask" or !$showExplanations.includes("Default")>>
		<<set _askShow to 1>> /*so "Ask for more information about each show" doesn't show up immediately after the shows are introduced for the first time*/
		<<if !$showExplanations.includes("Default")>><<run $showExplanations.push("Default")>><</if>>
		"첫 번째는 단순한 공연이야. 관객들과 약간의 유혹을 주고받다가, 관객 한 명을(사실은 연기자지만) 무대 위로 불러들여 너와 섹스하게 만드는 거지. 보수는 <<printmoney 60000 "green">> 줄게."
		<br><br>
		<<print $passage isnot "Briar's Office Show Ask" ? '<<He>>【이가】 자리에 앉는다.' : '<<He>>【은는】 선택지를 나열하며 손가락을 하나 더 들어 올린다.'>> "아니면 질 나쁜 동네에서 길을 잃은 깐깐한 여학생 연기를 할 수도 있어. 그러면 집단 강간이 이어지겠지. 이쪽은 보수가 <<printmoney 100000 "green">>【이】야. <span class="blue">물론 학생복이 필요할 거야.</span>" <<He>>【이가】 능글맞게 웃는다. "하지만 넌 이미 하나쯤 가지고 있을 것 같은데. 정곡을 찔렀나?"
		<br><br>
	<<else>>
		<<set _askShow to 0>>
	<</if>>

	<<if $settings.bestialityEnabled and ($passage is "Briar's Office Show Ask" or !$showExplanations.includes("Pig"))>>
		<<if !$showExplanations.includes("Pig")>><<run $showExplanations.push("Pig")>><</if>>
		"아니면," <<he>>【이가】 말을 잇는다. "근처 농장에서 돼지 한 마리를 데려올 수도 있어. 그러곤 네가 관객들의 유흥을 위해 그놈과 역겨운 짓을 하는 거지. 얼마나 많은 사람들이 좋아할진 모르겠지만, 확실히 입소문은 타게 될 거야. 우리가 원하는 바지. 보수는 <<printmoney 150000 "green">>【이】야."
		<br><br>
	<<elseif $settings.monsterChance gte 1 and ($passage is "Briar's Office Show Ask" or !$showExplanations.includes("Pig")) and ($hallucinations gte 1 or !$settings.monsterHallucinationsOnly)>>
		<<if !$showExplanations.includes("Pig")>><<run $showExplanations.push("Pig")>><</if>>
		"아니면," <<he>>【이가】 말을 잇는다. "근처 농장에서 돼지 수인 하나 데려올 수도 있어. 그러곤 네가 관객들의 유흥을 위해 그놈과 역겨운 짓을 하는 거지. 얼마나 많은 사람들이 좋아할진 모르겠지만, 입소문은 확실히 타게 될 거야. 우리가 원하는 바지. 보수는 <<printmoney 150000 "green">>【이】야."
		<br><br>
	<</if>>

	<<if $settings.swarmsEnabled and ($passage is "Briar's Office Show Ask" or !$showExplanations.includes("Swarm"))>>
		<<if !$showExplanations.includes("Swarm")>><<run $showExplanations.push("Swarm")>><</if>>
		<<He>>【이가】 잠시 뜸을 들인다. "그리고 최근에 너 같은 아이가 나오는 영상을 하나 봤는데," <<he>>【은는】 말을 잇는다. "작은 벌레들이 가득 찬 테라리움에 잠겨 있더군. 벌레였을 거야. 그걸 내 눈으로 직접 보고 싶어. 이 쇼도 보수는 똑같이 <<printmoney 150000 "green">> 주지."
		<br><br>
	<</if>>

	<<if $brothel_machine_repair gte 4 and ($passage is "Briar's Office Show Ask" or !$showExplanations.includes("Machine"))>>
		<<if !$showExplanations.includes("Machine")>><<run $showExplanations.push("Machine")>><</if>>
		<<if ($player.vaginaExist or $settings.analEnabled)>>
			"고쳐놓은 섹스 머신도 있어," <<he>>【이가】 마치 방금 생각난 듯 덧붙인다. "이건 프라이빗 쇼로 진행될 거야. 입이 싼 놈들은 사절이거든. 관객들은 참신함을 즐기겠지만, <span class="lewd">그들은 관통당하는 걸 보고 싶어 할 거야.</span> 끝까지 해낸다면 <<printmoney 150000 "green">>【을를】 주지."
			<br><br>
			<<if $settings.tentaclesEnabled>>
				<<He>>【이가】 턱을 톡톡 친다. "네 취향에 맞게 촉수 모드도 있었던 것 같은데. 보수는 똑같고, 여전히 네가 뚫려야 한다는 조건도 같지."
				<br><br>
			<</if>>
		<<elseif $settings.tentaclesEnabled>>
			"고쳐놓은 섹스 머신도 있어," <<he>>【이가】 마치 방금 생각난 듯 덧붙인다. "거기엔 촉수 모드가 있지. 프라이빗 쇼로 진행될 거야. 입이 싼 놈들은 사절이거든. 관객들은 참신함을 즐기겠지만, <span class="lewd">그들은 관통당하는 걸 보고 싶어 할 거야.</span> 끝까지 해낸다면 <<printmoney 150000 "green">>【을를】 주지."
			<br><br>
		<</if>>
	<</if>>
<</widget>>

<<widget "brothelshowoptions">>
	<<if $brothelVirginityIntro is true and $brothelVirginityState isnot "lie" and ($player.virginity.penile is true and $player.virginity.vaginal is true) and !unableTakeVirginity()>>
		<<if $brothelVirginityState is "refuse">>
			"네가 아직 첫 경험이 없다면, 그 특별 제안은 여전히 유효해." <<He>>【은는】 당신을 흘끗 쳐다본다. "물론 정말 그런지 확인부터 받아야겠지만. 세부적인 건 사람들이 얼마나 돈을 낼 의향이 있느냐에 달렸지만, 넌 분명 두둑하게 챙기게 될 거다."
			<br><br>
		<<elseif $brothelVirginityState is "virginity">>
			"팬들이 네 첫 경험을 차지할 기회를 한 번 더 달라고 요구해 왔어. 지난번엔 네가 아무한테도 넘겨주지 않았으니까," <<he>>【이가】 말한다. "그래도 덕분에 구경꾼은 꽤 많이 모였었지. 이번엔 얼마나 벌어들일지 모르겠지만, 누군가에겐 네 첫 경험을 가져가게 해줘야 할 거다."
			<br><br>
		<<elseif $brothelVirginityState is "chastity">>
			"지난번엔 사람들이 네게 불만이 많았고, 나도 마찬가지였어," <<he>>【은는】 당신을 흘끗 보며 말한다. "하지만 넌 아직 첫 경험이 없으니, 사람들은 기꺼이 그 기회에 돈을 내겠지. 네가 저번처럼 빌어먹을 장치 같은 걸 입고 나타나는 멍청한 짓만 하지 않는다면, 여전히 두둑하게 챙길 수 있을 거다."
			<br><br>
		<</if>>
		<<unset $brothelVirginityState>>
		특별 쇼:
		<br>
		<<if hasSexStat("promiscuity", 2)>>
			<<templeicon "virginity">><<link [[처녀를 판다|Briar's Office Virginity Show]]>><<acceptbrothelshow "virginity">><<set $phase to 0>><</link>><<promiscuous2>>
			<br>
		<<else>>
			<<insufficientStat "promiscuity" "처녀를 팔기엔">>
			<br>
		<</if>>
		<br>
	<</if>>

	기본 쇼:
	<br>
	<<if !hasSexStat("promiscuity", 4) and !hasSexStat("deviancy", 5)>>
		<<brothelicon>><<insufficientStat "custom" "제안 중 하나를 받아들이기엔" "blue" "음란 또는 이상성욕">>
		<br><br>
	<<else>>
		<<if hasSexStat("promiscuity", 4)>>
			<<brothelicon>><<link [[유혹하고 섹스하기|Briar's Office Show 2]]>><<acceptbrothelshow "flirt">><</link>> | <span class="green">+</span><<printmoney 60000 "green">><<promiscuous4>> <!-- Appears even with blind stats enabled. All are intentional -->
			<br>
		<<else>>
			<<brothelicon>><<insufficientStat "promiscuity" "유혹과 섹스 쇼를 맡기엔">>
			<br>
		<</if>>

		<<if hasSexStat("promiscuity", 5)>>
			<<schoolicon>><<link [[집단 강간 롤플레이|Briar's Office Show 2]]>><<acceptbrothelshow "gangbang">><</link>> | <span class="green">+</span><<printmoney 100000 "green">><<promiscuous5>>
			<br>
		<<else>>
			<<schoolicon>><<insufficientStat "promiscuity" "윤간 쇼를 맡기엔">>
			<br>
		<</if>>

		<<if hasSexStat("deviancy", 5) and ($settings.bestialityEnabled or ($settings.monsterChance gte 1 and ($hallucinations gte 1 or !$settings.monsterHallucinationsOnly)))>>
			<<animalicon "pig">><<link [[돼지|Briar's Office Show 2]]>><<acceptbrothelshow "pig">><</link>> | <span class="green">+</span><<printmoney 150000 "green">><<deviant5>>
			<br>
		<<else>>
			<<animalicon "pig">><<insufficientStat "deviancy" "돼지 쇼를 맡기엔">>
			<br>
		<</if>>

		<<if $settings.swarmsEnabled>>
			<<if hasSexStat("deviancy", 5)>>
				<<petshopicon "tanks">><<link [[생물들|Briar's Office Show 2]]>><<acceptbrothelshow "swarm">><</link>> | <span class="green">+</span><<printmoney 150000 "green">><<deviant5>>
				<br>
			<<else>>
				<<petshopicon "tanks">><<insufficientStat "deviancy" "스웜 쇼를 맡기엔">>
				<br>
			<</if>>
		<</if>>
		<br>
	<</if>>

	<<if $brothel_machine_repair is 1>>
		섹스 머신이 <span class="red">고장 났다.</span>
		<br><br>
	<<elseif $brothel_machine_repair is 2>>
		섹스 머신의 <span class="lewd">연료가 떨어졌다.</span>
		<br><br>
	<<elseif $brothel_machine_repair gte 4 and hasSexStat("promiscuity", 5) and ($settings.tentaclesEnabled or ($player.vaginaExist or $settings.analEnabled))>>
		섹스 머신 쇼:
		<br>
		<<if ($player.vaginaExist or $settings.analEnabled)>>
			<<sextoysicon>><<link [[섹스 머신|Briar's Office Show 2]]>><<acceptbrothelshow "machine">><</link>> | <span class="green">+</span><<printmoney 150000 "green">><<promiscuous5>>
			<br>
		<</if>>
		<<if $settings.tentaclesEnabled>>
			<<sextoysicon>><<link [[섹스 머신, 촉수 모드|Briar's Office Show 2]]>><<acceptbrothelshow "tentacles">><</link>> | <span class="green">+</span><<printmoney 150000 "green">><<promiscuous5>>
			<br>
		<</if>>
		<br>
	<</if>>

	<<if $demon gte 6 or (hasSexStat("deviancy", 5) and $farm_stage gte 7 and $farm.steed and ($settings.bestialityEnabled or $per_npc.saddled_steed.monster is "monster"))>>
		쇼 제안하기:
		<br>
		<<if hasSexStat("deviancy", 5) and $farm_stage gte 7 and $farm.steed and ($settings.bestialityEnabled or $per_npc.saddled_steed.monster is "monster")>>
			<<animalicon "horse">><<link [[말|Briar's Office Show 2]]>><<acceptbrothelshow "horse">><</link>> | <span class="green">+</span><<printmoney 200000 "green">><<deviant5>>
			<br>
		<</if>>
		<<if $demon gte 6>>
			<<sextoysicon "dildo">><<link [[부카케 게임|Briar's Office Show 2]]>><<acceptbrothelshow "bukkake">><</link>> | <span class="green">+관객 절정 1회당 <<printmoney 5000 "green">></span><<demon>>
			<br>
		<</if>>
		<br>
	<</if>>
<</widget>>

<<widget "startbrothelshow">>
	<<set _show to _args[0]>>
	<<if not $brothelshowdata.counts[_show]>>
		<<set $brothelshowdata.counts[_show] to 0>>
	<</if>>
	<<run $brothelshowdata.counts[_show]++>>
	<<run $brothelshowdata.counts.done++>>
	<<set $brothelshowdata.type to "none">>
	<<set $brothelshowdata.done to true>>
<</widget>>

<<widget "acceptbrothelshow">>
	<<set _show to _args[0]>>
	<<set $brothelshowdata.type to _show>>
	<<run $brothelshowdata.counts.agreed++>>
	<<if Time.weekDay is 6>>
		<<set $brothelshowdata.done to true>>
	<</if>>
<</widget>>

<<widget "abortbrothelshow">>
	<<set $brothelshowdata.type to "none">>
	<<run $brothelshowdata.counts.agreed-->>
	<<if Time.weekDay is 6>>
		<<set $brothelshowdata.done to false>>
	<</if>>
<</widget>>

<<widget "brothel_bukkake_init">>
	<<set $brothel_show_bukkake to 0>>
	<<set $brothel_show_security to 0>>
	<<set $brothel_show_flirt to 0>>
	<<set $brothel_show_crazed to 0>>
<</widget>>

<<widget "brothel_bukkake_end">>
	<<unset $brothel_show_bukkake>>
	<<unset $brothel_show_security>>
	<<unset $brothel_show_flirt>>
	<<unset $brothel_show_crazed>>
<</widget>>

<<widget "brothel_bukkake_links">>
	<<if $brothel_show_flirt isnot 1>>
		<<link [[추파를 던진다|Brothel Show Bukkake Flirt]]>><<set $brothel_show_flirt to 1>><</link>>
		<br>
	<</if>>
	<<link [[부드러운 유혹|Brothel Show Bukkake Gentle]]>><</link>>
	<br>
	<<link [[공격적인 유혹|Brothel Show Bukkake Aggressive]]>><</link>>
	<br>
	<<link [[쇼를 끝낸다|Brothel Show Bukkake End]]>><</link>>
	<br>
<</widget>>

<<widget "brothel_show_security">>
	<<switch $brothel_show_security>>
		<<case 0>>
			<span class="green">경비원들이 모든 상황을 통제하고 있다.</span>
		<<case 1>>
			<span class="teal">경비원들이 난동을 부리는 자를 내쫓는다.</span>
		<<case 2>>
			<span class="lblue">경비원들이 누군가를 때려눕힌다.</span>
		<<case 3>>
			<span class="blue">경비원들이 질서를 유지하려 고군분투하고 있다.</span>
		<<case 4>>
			<span class="purple">경비원들이 무대 쪽으로 밀려나며, 관객들을 간신히 저지하고 있다.</span>
		<<case 5>>
			<span class="pink">경비원들이 뚫리기 일보 직전이다.</span>
		<<default>>
			<span class="red">경비원들이 통제력을 잃었다! 관객들이 무대 위로 쇄도한다.</span>
	<</switch>>
<</widget>>

<<widget "brothel_bukkake">>
	<<for _i to 0; _i lt $NPCList.length; _i++>>
		<<switch _i>>
			<<case 0>>
				<<person1>>
			<<case 1>>
				<<person2>>
			<<case 2>>
				<<person3>>
			<<case 3>>
				<<person4>>
			<<case 4>>
				<<person5>>
			<<case 5>>
				<<person6>>
		<</switch>>
		<<if $NPCList[_i].penis isnot "none" and !$NPCList[_i].penisdesc.includes("strap-on")>>
			<<persons>> <<print window.KR.getPenisDescKr($NPCList[_i].penisdesc)>>【이가】 정액을 내뿜는다.
			<<random_semen>>
		<<else>>
			<<persons>> 보지에서 애액이 뿜어져 나온다.
			<<random_goo>>
		<</if>>
		<<set $brothel_show_bukkake += 1>>
	<</for>>
<</widget>>

<<widget "timeTrackingEndBrothel">>
	<<timeTrackingEnd "brothel">><<timeTrackingEnd "brothelDanceTips">><<timeTrackingEnd "brothelShow">>
<</widget>>

<<widget "brothelvirginitybidders">>
	<<if $numberBidder isnot undefined and $virginitytip gt $tip_add>>
		<<set $tip_add += ($virginitytip - $tip) * 0.5>><<tipset>>
	<</if>>

	<<if $numberBidder is undefined>>
		<<set $numberBidder to 1>>
	<</if>>

	<<if $numberBidder lte 6 and ($numberBidder lte 2 or _args[0] is undefined)>>
		<<generatetakevirginity $numberBidder>><<personselect $numberBidder-1>><<set $lastBidder to $numberBidder-1>><<set $numberBidder += 1>>
	<<else>>
		<<set _bidder to $numberBidder-2>> /* $numberBidder is 2~7, $lastBidder requires 0~5, so -2 */
		<<set _r to random(0, _bidder)>>

		<<if _r is $lastBidder>>
			<<set _r to _r % _bidder + 1>>
		<</if>>

		<<if _r is _highestBidder>>
			<<set _r to _r % _bidder + 1>>
		<</if>>

		<<set $lastBidder to _r>>
		<<personselect $lastBidder>>
	<</if>>
<</widget>>
